       <!-- Storage section: DS §3 header (NEX F2) + DS §2 elevated card
            (SSO-14757). "Storage" is the only header/accent pair on this page
            using the bare shared objectNames (sectionHeaderRow/Accent/Title)
            instead of a per-section suffix, so it picks up the existing
            #sectionHeaderAccent[accentToken="disk"] / @diskColor rule in
            style.qss that was present but unused until now — no new color
            decision, see style.qss for the System/Processor/etc. rationale
            on why those five use suffixed names instead. -->
       <item>
        <widget class="QWidget" name="sectionHeaderRow" native="true">
         <layout class="QHBoxLayout" name="sectionHeaderRowLayout">
          <property name="leftMargin"><number>2</number></property>
          <property name="topMargin"><number>0</number></property>

{
  "id": "gradle-cache",
  "name": "Gradle Caches",
  "app": "Gradle",
  "description": "Build caches, transforms, and daemon logs used by Gradle.",
  "platforms": ["macos"],
  "safety": "safe",
  "paths": [
    "$HOME/.gradle/caches/modules-*",
    "$HOME/.gradle/caches/transforms-*",
    "$HOME/.gradle/caches/jars-*",
    "$HOME/.gradle/caches/build-cache-*",
    "$HOME/.gradle/daemon/*/daemon-*.out.log"
  ],
  "minAgeDays": 14
}

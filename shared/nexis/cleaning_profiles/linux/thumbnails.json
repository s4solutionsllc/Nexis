{
  "id": "thumbnail-cache",
  "name": "Thumbnail Cache",
  "app": "XDG thumbnail cache",
  "description": "Cached thumbnails generated by file managers per the XDG thumbnail spec.",
  "platforms": ["linux"],
  "safety": "safe",
  "paths": [
    "$HOME/.cache/thumbnails/normal",
    "$HOME/.cache/thumbnails/large",
    "$HOME/.cache/thumbnails/fail"
  ],
  "minAgeDays": 30
}

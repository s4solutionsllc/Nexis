#repoDiagIcon[diagStatus="warning"] { color: @warningColor; }
#repoDiagIcon[diagStatus="failed"]  { color: @destructiveColor; }

#repoSuggestion {
    color: @warningColor;
    font-style: italic;
}

#repoDiagnoseStep {
    color: @color05;
    background-color: transparent;
}


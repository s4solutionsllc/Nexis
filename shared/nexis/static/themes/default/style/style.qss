    color: @color04;
}

#fwDetailCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8px;
}

#fwDetailCard QLabel {
    color: @color04;
    font-size: 12px;
}

#fwWarning {
    color: @warningColor;
    font-size: 13px;
}

#fwHelpBtn {
    color: @color04;
    font-size: 14px;
    font-weight: bold;
    border: 1px solid @color04;
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

#fwRefresh {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

#fwRefresh:hover {
    border-color: @accentColor;
}

#fwRefresh:disabled {
    color: @color04;
}

/* Open Ports Widget */

#portsTitle {
    color: @color05;
    font-size: 16px;
    font-weight: bold;
}

#portsSearch {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

#portsSearch:focus {

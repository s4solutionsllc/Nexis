    font-size: 12px;
}

/* Network Diagnostics Widget */

#netDiagTitle {
    color: @color05;
    font-size: 16px;
    font-weight: bold;
}

#netDiagCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8px;
}

#netDiagSubheader {
    color: @color05;
    font-size: 14px;
    font-weight: bold;
}

#netDiagSecondary {
    color: @color04;
    font-size: 12px;
}

#netDiagLoading {
    color: @color04;
    font-size: 13px;
}

#netDiagRetest {
    background-color: @accentColor;
    color: @color07;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

#netDiagRetest:hover {

/****** ADWAITA THEME ******/

/*****************
    QScrollArea
******************/
QScrollArea {
    border: 0;
}

QScrollBar:vertical {
    width: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:vertical {
    background-color: @color06;
    min-height: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:vertical:hover {
    background-color: @color04;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    height: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:horizontal {
    background-color: @color06;
    min-width: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:horizontal:hover {
    background-color: @color04;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

/*************
    QDialog
**************/
QDialog {
    background-color: @color01;
}

QDialog QLabel {
    color: @color05;
}

/*************
    QMessageBox
**************/
QMessageBox {
    background-color: @color01;
}

QMessageBox QLabel {
    color: @color05;
}

/*************
    QMenu
**************/
QMenu {
    background-color: @color01;
    border-radius: 8;
    border: 1px solid @borderColor;
    padding: 4 0;
}

QMenu::item {
    padding: @dp6 @dp24;
    color: @color05;
    font-size: 10pt;
    border-radius: @dp6;
    margin: @dp2 @dp4;
}

QMenu::item:selected {
    background-color: @accentColor;
    color: @color07;
}

QMenu::indicator {
    width: @dp14px;
    height: @dp14px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QRadioButton
******************/

QRadioButton {
    color: @color12;
    font-size: 11pt;
}

QRadioButton::indicator {
    width: @dp16;
    height: @dp16;
}

QRadioButton::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QRadioButton::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QCheckBox
******************/

QCheckBox {
    color: @color05;
}

QCheckBox::indicator {
    width: @dp44px;
    height: @dp24px;
}

QCheckBox::indicator:checked {
    image: url(:/static/themes/common/img/checkbox.png);
}

QCheckBox::indicator:unchecked {
    image: url(:/static/themes/common/img/un-checkbox.png);
}

QCheckBox:focus {
    outline: none;
    border: none;
}

QCheckBox[accessibleName="circle"] {
    font-size: 10pt;
    color: @color06;
}

QCheckBox[accessibleName="circle"]::indicator {
    width: @dp18px;
    height: @dp18px;
}

QCheckBox[accessibleName="circle"]::indicator:unchecked {
    image: url(:/static/themes/common/img/circle-unchecked.svg);
}

QCheckBox[accessibleName="circle"]::indicator:checked {
    image: url(:/static/themes/common/img/circle-checked.svg);
}

/*****************
    QToolTip
******************/

QToolTip {
    color: @color05;
    padding: 4 8;
    background-color: @color01;
    border: 1px solid @borderColor;
    border-radius: 6;
}

/***************
    Not Found
***************/

#notFoundWidget, QWidget[accessibleName="notFoundWidget"] {
    background: url(:/static/themes/common/img/not-found.png) no-repeat top center;
}

#notFoundWidget QLabel, QWidget[accessibleName="notFoundWidget"] {
    color: @color06;
    font-size: 13pt;
}

/***************
    QSpinBox
***************/

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spinup.svg) 1;
    border-width: 1px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spindown.svg) 1;
    border-width: 1px;
    border-top-width: 0;
}

/***************
    QSlider
***************/

QSlider::groove:horizontal {
    height: 4px;
    background: @borderColor;
    margin: 2px 0;
    border-radius: 2;
}

QSlider::handle:horizontal {
    background-color: @accentColor;
    width: @dp16px;
    height: @dp16px;
    margin: -@dp6px 0;
    border-radius: @dp8px;
}

/***************
    QComboBox
***************/

QComboBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    background-color: @color01;
    padding: @dp6 @dp12;
    font-size: 10pt;
    color: @color05;
    min-width: @dp100;
}

QComboBox:hover {
    border-color: @color04;
}

QComboBox::drop-down {
    background-color: transparent;
    subcontrol-position: top right;
    width: @dp20;
    padding: 0 @dp6;
    border: 0;
    border-top-right-radius: 6;
    border-bottom-right-radius: 6;
}

QComboBox::down-arrow {
    image: url(:/static/themes/common/img/chevron-down.svg);
    width: 10;
    height: 6;
}

QComboBox QAbstractItemView {
    background-color: @color01;
    border: 1px solid @borderColor;
    border-radius: 6;
    selection-background-color: @accentColor;
    selection-color: @color07;
}

/***************
    QGroupBox
***************/

QGroupBox::title {
    font-size: 11pt;
    font-weight: bold;
    color: @color06;
}

/***************
    QTableView
***************/

QTableView {
    background-color: transparent;
    selection-color: @color05;
    color: @color05;
    font-size: 10pt;
    gridline-color: @borderColor;
    border-radius: 6;
}

QTableView::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

QTableView::item:selected {
    background-color: @color02;
}

QHeaderView::section {
    background-color: @color02;
    border-width: 0 0 1 0;
    border-style: solid;
    border-color: @borderColor;
    font-size: 10pt;
    color: @accentColor;
    padding: @dp8 @dp12;
}

QHeaderView::up-arrow {
    image: url(:/static/themes/common/img/sort-asc.svg);
    width: 10;
    height: 8;
}

QHeaderView::down-arrow {
    image: url(:/static/themes/common/img/sort-dsc.svg);
    width: 10;
    height: 8;
}

/******************
    QMainWindow
*******************/

QMainWindow * {
    font-family: "Ubuntu", system-ui, sans-serif;
}

QLineEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    padding: @dp8;
    background-color: @color01;
    font-size: 10pt;
    color: @color05;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: @accentColor;
}

QPushButton {
    border-radius: @dp6;
    font-size: 10pt;
    padding: @dp8 @dp16;
    min-height: @dp18;
}

QPushButton[accessibleName="danger"] {
    background-color: @destructiveColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="danger"]:hover {
    background-color: @color09;
}

QPushButton[accessibleName="primary"] {
    background-color: @accentColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="primary"]:hover {
    background-color: @accentHover;
}

QLabel[accessibleName="dialog-title"] {
    color: @color05;
    font-size: 12pt;
    font-weight: bold;
    padding-bottom: 8;
    border: 0;
    border-bottom: 1px solid @borderColor;
}

#lblErrorMsg {
    color: @destructiveColor;
}

/**************
    Sidebar
***************/

#sidebar {
    background-color: @sidebar;
    border-right: 1px solid @borderColor;
}

#sidebar QPushButton {
    border: 0;
    height: @dp36;
    border-radius: @dp6;
    color: @color06;
    margin: 1 @dp8;
    padding: 0 @dp12;
    text-align: left;
    font-size: 10pt;
    border-left: 3px solid transparent;
}

#sidebar QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    font-weight: 600;
    border-left: 3px solid @accentColor;
}

#sidebar QPushButton:hover:!checked {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @borderColor;
}

/* Section headers */
#sectionHeader {
    font-size: 8pt;
    font-weight: 600;
    color: @tertiaryText;
    padding: 12px 12px 4px 20px;
    text-transform: uppercase;
    border: 0;
    border-top: 1px solid @borderColor;
    margin-top: 6px;
    background: transparent;
}

/* Sidebar logo */
#sidebarLogo {
    background: transparent;
    border: 0;
}

/* Sidebar toggle button */
#btnSidebarToggle {
    border: 0;
    border-radius: @dp4;
    background: transparent;
    padding: 0;
}

#btnSidebarToggle:hover {
    background-color: @color02;
}

/* Collapsed sidebar overrides */
#sidebar[collapsed="true"] QPushButton {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 3px solid transparent;
}

#sidebar[collapsed="true"] QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    border-left: 0;
    border-bottom: 3px solid @accentColor;
}

#sidebar[collapsed="true"] QPushButton:hover:!checked {
    border-left: 0;
    border-bottom: 3px solid @borderColor;
}

#sidebar[collapsed="true"] #btnSidebarToggle {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 0;
}

#sidebarDividerLine {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 4 12;
}

#sidebarVersionLabel {
    color: @tertiaryText;
    font-size: 8pt;
    padding: 0 12;
}

#sidebarBadge {
    background-color: @accentColor;
    color: #ffffff;
    font-size: 7pt;
    font-weight: 700;
    border-radius: 8;
    padding: 1 6;
    min-width: 16;
    max-height: 16;
}

#sidebarBadgeDot {
    background-color: @accentColor;
    border-radius: 4;
    min-width: 8;
    max-width: 8;
    min-height: 8;
    max-height: 8;
}

#sidebarSectionIndicator {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 2 16;
}

/********************
    COMMAND PALETTE
*********************/

#commandPaletteInner {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#commandPaletteSearch {
    background-color: @color01;
    color: @color05;
    border: 0;
    border-bottom: 1px solid @borderColor;
    border-radius: 12px 12px 0 0;
    padding: 14 16;
    font-size: 13pt;
}

#commandPaletteSearch:focus {
    border-bottom: 1px solid @accentColor;
}

#commandPaletteResults {
    background-color: transparent;
    border: 0;
    padding: 4 0;
}

#commandPaletteResults::item {
    color: @color06;
    padding: 8 16;
    border: 0;
    font-size: 10pt;
}

#commandPaletteResults::item:selected {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @accentColor;
}

#commandPaletteResults::item:hover:!selected {
    background-color: @color02;
}

#pageContent {
    background-color: @pageContent;
}

/********************
    DASHBOARD PAGE
*********************/

/* - Circle Bar - */

#widgetCircleBar {
    background-color: @cardBg;
    border-radius: 12;
}

#lblCircleChartTitle,
#lblCircleChartValue {
    color: @color05;
    font-size: 13pt;
    margin: 0;
}

/* - Line Bar - */

#lineChartWidget {
    background-color: @cardBg;
    border-radius: 12;
}

#lblLineChartTitle {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartValue {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartTotal {
    color: @color06;
    font-size: 10pt;
}

#lineChartProgress {
    background-color: @color02;
    border: 0;
    border-radius: 3;
    max-height: 6;
}

#lineChartProgress::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 @accentColor, stop:1 @accentHover);
    border-radius: 3;
}

/* - Hero Card (CPU + Memory combined) - */

#heroCard {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#heroCard:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#heroCardLeft, #heroCardRight {
    background-color: transparent;
    border: 0;
    border-radius: 0;
}

#heroCardDivider {
    background-color: @borderColor;
    border: 0;
    max-width: 1;
    margin: 10 0;
}

/* - Metric Tile - */

#metricTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#metricTile:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#metricTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#metricTileValue {
    color: @color05;
    font-size: 18pt;
    font-weight: 700;
}

#metricTileValue[heroMode="true"] {
    font-size: 36pt;
}

#metricTileValue[largeMode="true"] {
    font-size: 30pt;
}

#metricTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

#metricTileProgress {
    background-color: @color02;
    border: 0;
    border-radius: 2;
    max-height: 4;
}

#metricTileProgress::chunk {
    border-radius: 2;
}

#metricTileAction {
    font-size: 8pt;
    padding: 2 8;
    border-radius: 10;
    background: transparent;
}

/* - Disk Donut Tile - */

#diskTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#diskTile:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#diskTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#diskTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

/* - Network Tile - */

#networkTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#networkTile:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#networkTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#networkDivider {
    background-color: @borderColor;
    border: 0;
    max-height: 1;
    margin: 4 0;
}

#networkTileLabel {
    font-size: 9pt;
    font-weight: 600;
}

#networkTileValue {
    color: @color05;
    font-size: 13pt;
    font-weight: 700;
}

#networkTileFooter {
    color: @tertiaryText;
    font-size: 8pt;
}

#networkTileInterface {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - System Summary Card - */

#systemSummaryCard {
    background-color: @cardBg;
    border-radius: 10;
    border: 1px solid @borderColor;
}

#summaryLabel {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 600;
}

#summaryValue {
    color: @color05;
    font-size: 10pt;
}

/* - Quick Actions Card - */

#quickActionsCard {
    background-color: @cardBg;
    border-radius: 10;
    border: 1px solid @borderColor;
}

#quickActionsTitle {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 600;
}

#quickActionBtn {
    font-size: 9pt;
    padding: 6 16;
    border-radius: 14;
    border: 1px solid @borderColor;
    color: @color06;
    background-color: transparent;
}

#quickActionBtn:hover {
    background-color: @color02;
    color: @color05;
}

#quickActionBtn[accessibleName="quickActionPrimary"] {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#quickActionBtn[accessibleName="quickActionPrimary"]:hover {
    background-color: @accentHover;
    border-color: @accentHover;
}

/* - Status Footer - */

#statusFooter {
    background-color: @sidebar;
    border-top: 1px solid @borderColor;
    border-radius: 0;
}

#statusFooter QLabel {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - Temperature Gauge - */

#tempContainer {
    background-color: @cardBg;
    border-radius: 12;
}

#cmbTempSensor {
    background-color: @color02;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 6;
    padding: 4 8;
    font-size: 10pt;
}

#cmbTempSensor::drop-down {
    border: 0;
    width: 20;
}

#cmbTempSensor QAbstractItemView {
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
    selection-background-color: @color02;
}

/* - Kiosk Toggle Button - */

#btnKioskToggle {
    border: 0;
    background-color: transparent;
    border-radius: @dp4;
}

#btnKioskToggle:hover {
    background-color: @color02;
}


/**************************
    HARDWARE INFO PAGE
***************************/

#HardwareInfoPage {
    background-color: transparent;
}

#HardwareInfoPage #scrollArea,
#HardwareInfoPage #scrollContent {
    background-color: transparent;
}

#HardwareInfoPage QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    background-color: @cardBg;
}

#HardwareInfoPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

#HardwareInfoPage QTableWidget {
    background-color: transparent;
    border: 0;
}

#HardwareInfoPage QTableWidget::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

/**************************
    SYSTEM CLEANER PAGE
***************************/

#cleanerCategories QCheckBox[accessibleName=circle]::indicator {
    width: @dp26;
    height: @dp26;
}

#cleanerCategories QLabel,
#checkSelectAllSystemScan {
    font-size: 11pt;
    color: @color05;
}

/* - System Scan Button - */

#SystemCleanerPage #btnScan {
    border: 0;
    border-radius: @dp6px;
    background-color: @accentColor;
    color: #ffffff;
    font-size: 12pt;
    font-weight: bold;
    padding: @dp8px @dp24px;
}

#SystemCleanerPage #btnScan:hover {
    background-color: @accentHover;
}

/* - System Clean Button - */

#SystemCleanerPage #btnClean {
    border: 0;
    background: url(:/static/themes/@themeName/img/clean.png) no-repeat center;
}

#SystemCleanerPage #btnClean:hover {
    background: url(:/static/themes/@themeName/img/clean-active.png) no-repeat center;
}

/* - System Scan Results - */

#btnBackToCategories {
    border: 0;
    font-size: 11pt;
    color: @accentColor;
}

#treeWidgetScanResult {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 6;
}

#treeWidgetScanResult QHeaderView::section {
    border-top: 1;
}

#treeWidgetScanResult::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetScanResult::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetScanResult::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetScanResult::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetScanResult::branch:has-children:!has-siblings:closed,
#treeWidgetScanResult::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch:open:has-children:!has-siblings,
#treeWidgetScanResult::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch {
    border-bottom: 1px solid @borderColor;
}

#lblRemovedTotalSize {
    font-size: 11pt;
    color: @successColor;
}

#lblTotalBytes {
    font-size: 11pt;
    color: @color05;
}

/* - Schedule Indicator - */

#scheduleIndicator {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 6;
    padding: 8;
}

#lblLastSchedule {
    font-size: 9pt;
    color: @color06;
}

/************************
    STARTUP APPS PAGE
*************************/
#listWidgetStartup {
    background-color: transparent;
}

#lblStartupAppsTitle {
    color: @color11;
    padding: 10 0 10 12;
}

/* - Startup App - */

#widgetStartupApp {
    border-radius: 12;
    background-color: @cardBg;
}

#lblStartupAppIcon {
    image: url(:/static/themes/@themeName/img/app.png);
}

#widgetStartupApp:hover {
    background-color: @color02;
}

#widgetStartupApp #lblStartupAppName {
    font-size: 10pt;
    color: @color05;
}

#checkStartup {
    margin-top: 3;
}

#widgetStartupApp #btnDeleteStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/trash.png);
    border: 0;
}

#widgetStartupApp #btnEditStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/edit.png);
    border: 0;
    margin-bottom: 2;
}

/* - Startup App Edit - */

#StartupAppEdit {
    background-color: @pageContent;
}

/**************************
    SERVICES PAGE
***************************/

#ServicesPage QListWidget {
    background-color: transparent;
}

#lblServicesTitle {
    font-size: 11pt;
    color: @color11;
    padding: 10 0;
}

/* - Service Item - */

#serviceItemWidget {
    border-radius: 12;
    background-color: @cardBg;
}

#serviceItemWidget:hover {
    background-color: @color02;
}

#lblServiceIcon {
    image: url(:/static/themes/@themeName/img/service.png);
}

#ServiceItem #lblServiceName {
    font-size: 10pt;
    color: @color05;
}

#ServiceItem #lblServiceDescription {
    font-size: 9pt;
    color: @color06;
}

#lblServiceStartupImg {
    image: url(:/static/themes/@themeName/img/power.svg);
}

#lblSystemRunningImg {
    image: url(:/static/themes/@themeName/img/run.svg);
}

/**********************
    PROCESSES PAGE
***********************/

#lblProcessTitle {
    color: @color11;
    padding: 10 0;
    font-size: 11pt;
}

#checkAllProcesses {
    margin-top: 2;
    color: @color12;
    font-size: 10pt;
}

#checkAllProcesses::indicator {
    width: @dp14;
    height: @dp14;
}

#txtProcessSearch {
    width: @dp180;
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

#lblRefresh {
    color: @color12;
    font-size: 10pt;
}

#sliderRefresh {
    margin-top: 3;
}

/************************
    UNINSTALLER PAGE
*************************/

#nav QPushButton {
    border-radius: @dp6;
    padding: @dp6 @dp12;
    font-size: 10pt;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

#nav QPushButton:hover,
#nav QPushButton:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#lblPackagesTitle {
    color: @color11;
    padding: 10 0;
    font-size: 11pt;
}

#txtPackageSearch,
#txtSearchAptSource {
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

/* -- Package tree (Uninstaller + Homebrew) -- table style matching System Cleaner -- */

#treeWidgetPackages {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 6;
    font-size: 10pt;
}

#treeWidgetPackages QHeaderView::section {
    border-top: 1;
}

#treeWidgetPackages::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetPackages::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetPackages::branch:has-children:!has-siblings:closed,
#treeWidgetPackages::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch:open:has-children:!has-siblings,
#treeWidgetPackages::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Snap package list (card style, unchanged) -- */

#listWidgetSnapPackages {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#listWidgetSnapPackages::indicator {
    width: @dp16;
    height: @dp16;
}

#listWidgetSnapPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#listWidgetSnapPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#listWidgetSnapPackages::item {
    border-radius: @dp8;
    min-height: @dp36;
    background-color: @cardBg;
    margin: 1 0;
}

#listWidgetSnapPackages::item:text {
    color: @color05;
    padding-left: @dp12;
}

#listWidgetSnapPackages::item:selected {
    background-color: @color02;
    border: 0;
}

#listWidgetSnapPackages::item:hover {
    background-color: @color02;
}

/****************
    HISTORIES
*****************/

#charts {
    background-color: @pageContent;
}

#lblHistoryTitle {
    font-size: 11pt;
    margin: 6 0 10 0;
    color: @color12;
}

#checkHistoryTitle::indicator {
    width: @dp16;
    height: @dp16;
}

#checkHistoryTitle::indicator:unchecked {
    image: url(:/static/themes/@themeName/img/fit.png);
}

#checkHistoryTitle::indicator:checked {
    image: url(:/static/themes/@themeName/img/collapse.png);
}

/***************
    SETTINGS
****************/

#SettingsPage QLabel {
    font-size: 10pt;
    color: @color12;
}

#lblCreatedBy {
    font-size: 9pt;
    color: @color06;
}

#SettingsPage QLabel[accessibleName="title"] {
    font-size: 11pt;
    font-weight: bold;
    color: @color05;
    padding-top: 8;
}

#lblQuickSetupSummary {
    font-size: 9pt;
    color: @color06;
}

/* - Shared dialog label styles - */

QLabel[accessibleName="dimmed"] {
    color: @color06;
}

QLabel[accessibleName="dimmed-small"] {
    font-size: 9pt;
    color: @color06;
}

#lblTrashWarning {
    font-size: 9pt;
    color: @warningColor;
}

/*****************
    UPDATE BAR
******************/

#widgetUpdateBar {
    background-color: @accentColor;
    border-radius: 6;
}

#lblUpdateBarText {
    font-size: 10pt;
    color: @color07;
}

#btnDownloadUpdate {
    background-color: @color01;
    padding: @dp2 @dp10;
    border-radius: @dp4;
    font-size: 9pt;
    max-height: @dp22px;
}

/****************
    FEEDBACK
*****************/

#Feedback {
    background-color: @pageContent;
}

/**************************
    APT SOURCE MANAGER PAGE
***************************/
#listWidgetAptSources {
    background-color: transparent;
}

#lblAptSourceTitle {
    color: @color11;
    padding: 10 0 5 12;
}

#txtAptSource {
    padding: 8;
}

#lblAptSourceSelectInfo {
    margin-top: 5;
    font-size: 10pt;
    color: @color05;
}

#listWidgetAptSources {
    selection-background-color: @accentColor;
}

/* - APT Source Repository Item - */

#aptSourceRepositoryItemWidget {
    border-radius: 12;
    background-color: @cardBg;
}

#lblAptSourceIcon {
    image: url(:/static/themes/@themeName/img/ppa-repository.png);
}

#aptSourceRepositoryItemWidget:hover {
    background-color: @color02;
}

#lblAptSourceName {
    font-size: 10pt;
    color: @color05;
}

#checkAptSource {
    margin-top: 3;
}

/* - APT Source Repository Item Edit - */

#APTSourceEdit {
    background-color: @pageContent;
}

/**************************
    GNOME SETTINGS PAGE
***************************/

#GnomeSettingsPage QLabel {
    font-size: 10pt;
    color: @color12;
}

#GnomeSettingsPage QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    padding: 12 12 6 12;
    background-color: @cardBg;
}

#GnomeSettingsPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

/* Tab nav buttons */
#GnomeSettingsPage QPushButton[accessibleName="navBtn"] {
    border-radius: @dp6;
    padding: @dp6 @dp12;
    font-size: 10pt;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

#GnomeSettingsPage QPushButton[accessibleName="navBtn"]:hover,
#GnomeSettingsPage QPushButton[accessibleName="navBtn"]:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

/* Browse buttons */
#btnBrowseWallpaper,
#btnBrowseWallpaperDark {
    background-color: @color01;
    padding: @dp6 @dp12;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#btnBrowseWallpaper:hover,
#btnBrowseWallpaperDark:hover {
    border-color: @color04;
}

/* Speed value labels */
#GnomeSettingsPage #lblMouseSpeedVal,
#GnomeSettingsPage #lblTouchpadSpeedVal {
    color: @color05;
    font-weight: bold;
}

/* Inline error status label */
#GnomeSettingsPage #lblStatus {
    color: #d32f2f;
    background-color: rgba(211, 47, 47, 0.08);
    border: 1px solid rgba(211, 47, 47, 0.25);
    border-radius: 6;
    padding: 6 12;
    font-size: 9pt;
}

/*******************************
SEARCH
*******************************/
#txtSearchInput {
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

#btnSearchAdvance {
    padding: @dp6 @dp12;
    background-color: @accentColor;
    color: @color07;
    border-radius: @dp6;
}

#lblFoundFilesInfo {
    color: @successColor;
}

#lblSearchDir {
    font-size: 10pt;
    color: @color06;
}

#btnBrowseSearchDir {
    background-color: @color01;
    padding: @dp6 @dp12;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#advanceSearchPane QSpinBox {
    padding: @dp4 @dp6;
}

#advanceSearchPane QCheckBox[accessibleName="circle"]::indicator {
    width: @dp15px;
    height: @dp15px;
}

#advanceSearchPane QLabel {
    color: @color06;
}

#advanceSearchPane QLineEdit {
    padding: @dp4 @dp6;
}

#btnAdvancePaneToggle,
#btnNewHost {
    font-size: 10pt;
    color: @accentColor;
    border: 0;
}

#lblHostTitle {
    font-size: 11pt;
    color: @color12;
}

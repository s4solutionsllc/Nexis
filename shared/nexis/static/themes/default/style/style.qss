}

/* Power Profile Widget (Helpers page, Linux only) */

#powerProfileWidget {
    background-color: @cardBg;
    border-radius: 6px;
}

#powerProfileLabel {
    color: @color05;
    font-size: 12px;
}

#powerProfileWidget QPushButton {
    background-color: @cardBg;
    color: @color04;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

#powerProfileWidget QPushButton:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#powerProfileWidget QPushButton:hover:!checked {
    border-color: @accentColor;
}

#verifyDiskStatus {
    font-weight: bold;
}

#powerProfileWarning {
    color: @warningColor;
    font-size: 11px;
    padding: 2px 0;
}

/* Action bar and buttons */

/* DS §3 spacing: plain footer band with a top hairline, not its own
   bordered card — the two elevated containers above carry the page's
   shadows (NEX F1). */
#DiskToolsPage #actionBarFrame {
    background-color: transparent;
    border: 0;
    border-top: 1px solid @borderColor;
}

#DiskToolsPage #btnScan {
    border: 0;
    border-radius: @dp6;
    background-color: @accentColor;
    color: @color07;
    font-size: 10pt;
    font-weight: bold;
    padding: @dp8 @dp24;
}

#DiskToolsPage #btnScan:hover {
    background-color: @accentHover;
}

#DiskToolsPage #btnTrash {
    border: 0;
    border-radius: @dp6;
    background-color: @destructiveColor;
    color: @color07;
    font-size: 10pt;
    font-weight: bold;
    padding: @dp8 @dp16;
}

#DiskToolsPage #btnTrash:hover {
    background-color: @color09;
}

#DiskToolsPage #btnTrash:disabled {
    background-color: @borderColor;
    color: @color04;
}

#DiskToolsPage #lblStatus {
    font-size: 10pt;
    color: @color06;
}

/****************
    HISTORIES
*****************/
/* NEX Phase-2 "Resources" page selectors (history chart bands) live here. */

#charts {
    background-color: @pageContent;
}

#lblHistoryTitle {
    font-size: 11pt;
    margin: 6 0 10 0;
    color: @color12;
}

#checkHistoryTitle::indicator {
    width: @dp16;
    height: @dp16;
}

#checkHistoryTitle::indicator:unchecked {
    image: url(:/static/themes/@themeName/img/fit.png);
}

#checkHistoryTitle::indicator:checked {
    image: url(:/static/themes/@themeName/img/collapse.png);
}

/***************
    SETTINGS
****************/

#SettingsPage #scrollArea,
#SettingsPage #scrollContent {
    background-color: transparent;
}

#SettingsPage QGroupBox {
    border: none;
    border-radius: 0;
    margin-top: 24;
    padding: 8 0 0 0;
    background-color: transparent;
}

#SettingsPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

#SettingsPage QLabel {
    font-size: 10pt;
    color: @color12;
}

#lblCreatedBy {
    font-size: 9pt;
    color: @color06;
}

#lblQuickSetupSummary {
    font-size: 9pt;
    color: @color06;
}

/* - Shared dialog label styles - */

QLabel[accessibleName="dimmed"] {
    color: @color06;
}

QLabel[accessibleName="dimmed-small"] {
    font-size: 9pt;
    color: @color06;
}

/* - Status property selectors (semi-dynamic: set via setProperty("status", ...)) - */
/*
 * NEX F3 (DS §5): confirmed this set already covers every semantic color a
 * consuming page needs (success/warning/error/info/dimmed/neutral) — no new
 * per-page color selectors added for the Services or System Logs status-pill
 * consumers, they set the pill track via #metricTileTrend (style.qss:908-914)
 * and pick a text color from these six.
 *
 * Open observation for whoever implements the System Logs page item:
 * notes/system_logs.md describes NOTICE severity as "info (@infoColor)", but
 * [status="info"] below resolves to @color05 (primary text, not the blue
 * @infoColor token used elsewhere e.g. style.qss:1472). [status="info"] is
 * also live on the Dashboard maintenance wizard's step icon
 * (maintenance_wizard_dialog.cpp) — changing its value here is a
 * cross-consumer change outside F3's groundwork-only scope, left for that
 * item to resolve deliberately (either update the shared value with an
 * explicit before/after check on the wizard, or use [status="dimmed"] /
 * another existing semantic for NOTICE instead).
 */

[status="success"] { color: @successColor; }
[status="warning"] { color: @warningColor; }
[status="error"]   { color: @destructiveColor; }
[status="info"]    { color: @color05; }
[status="dimmed"]  { color: @color04; }
[status="neutral"] { color: @tertiaryText; }

#wizardStepIcon {
    font-weight: bold;
}

#wizardStepIcon[status="success"] { font-size: 16px; }
#wizardStepIcon[status="warning"] { font-size: 14px; font-weight: normal; }
#wizardStepIcon[status="info"]    { font-size: 14px; }
#wizardStepIcon[status="error"]   { font-size: 16px; }

#lblTrashWarning {
    font-size: 9pt;
    color: @warningColor;
}

/*****************
    UPDATE BAR
******************/

#widgetUpdateBar {
    background-color: @accentColor;
    border-radius: 6;
}

#lblUpdateBarText {
    font-size: 10pt;
    color: @color07;
}

#btnDownloadUpdate {
    background-color: @color01;
    color: @color05;
    padding: @dp2 @dp10;
    border-radius: @dp4;
    font-size: 9pt;
    max-height: @dp22px;
}

/****************
    FEEDBACK
*****************/

#Feedback {
    background-color: @pageContent;
}

/**************************
    APT SOURCE MANAGER PAGE
***************************/
#listWidgetAptSources {
    background-color: transparent;
}

#lblAptSourceTitle {
    color: @color11;
    padding: 10 0 5 12;
}

/* - Homebrew: "Available Updates (N)" title (mLblUpdatesTitle) - */
#lblUpdatesTitle {
    color: @color11;
    padding: 10 0 5 12;
}

#txtAptSource {
    padding: 8;
}

#lblAptSourceSelectInfo {
    margin-top: 5;
    font-size: 10pt;
    color: @color05;
}

#listWidgetAptSources {
    selection-background-color: @accentColor;
}

/* - APT Source Repository Item - */

#aptSourceRepositoryItemWidget {
    border-radius: 12;
    background-color: @cardBg;
    border: 1px solid transparent;
}

#lblAptSourceIcon {
    image: url(:/static/themes/@themeName/img/ppa-repository.png);
}

#aptSourceRepositoryItemWidget:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#lblAptSourceName {
    font-size: 10pt;
    color: @color05;
    font-family: @monoFontFamily;
}

#lblRepoDescription {
    color: @tertiaryText;
}

#repoStatusDot {
    font-size: 10px;
    font-weight: bold;
}

#aptSourceRepositoryItemWidget[repoStatus="success"] { border-left: 3px solid @successColor; }
#aptSourceRepositoryItemWidget[repoStatus="warning"] { border-left: 3px solid @warningColor; }
#aptSourceRepositoryItemWidget[repoStatus="error"]   { border-left: 3px solid @destructiveColor; }
#aptSourceRepositoryItemWidget[repoStatus="neutral"] { border-left: 3px solid @tertiaryText; }

#checkAptSource {
    margin-top: 3;
}

/* - Repo Detail Panel - */

#repoDetailPanel {
    background-color: @pageContent;
    border-left: 1px solid @borderColor;
}

#repoDetailName {
    color: @color05;
}

#repoDetailDescription {
    color: @color04;
}

#repoDetailMetadata {
    background-color: transparent;
}

#repoMetaLabel {
    font-size: 9px;
    color: @tertiaryText;
    background-color: transparent;
}

#repoMetaValue {
    color: @color05;
    background-color: transparent;
}

#repoStatusBadge {
    color: @color07;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}

#repoStatusBadge[repoStatus="healthy"] { background-color: @successColor; }
#repoStatusBadge[repoStatus="warning"] { background-color: @warningColor; }
#repoStatusBadge[repoStatus="error"]   { background-color: @destructiveColor; }
#repoStatusBadge[repoStatus="unknown"] { background-color: @tertiaryText; }

#repoMetaValue[repoStatus="healthy"] { color: @successColor; }
#repoMetaValue[repoStatus="warning"] { color: @warningColor; }
#repoMetaValue[repoStatus="error"]   { color: @destructiveColor; }
#repoMetaValue[repoStatus="unknown"] { color: @tertiaryText; }

#repoIssueCard {
    background-color: @cardBg;
    border-radius: 4px;
}

#repoIssueCard[issueSeverity="error"]   { border-left: 3px solid @destructiveColor; }
#repoIssueCard[issueSeverity="warning"] { border-left: 3px solid @warningColor; }
#repoIssueCard[issueSeverity="info"]    { border-left: 3px solid @tertiaryText; }

#repoIssueCard QPushButton[accessibleName="primary"] {
    background-color: @accentColor;
    color: @color07;
    border: 0;
    border-radius: @dp4;
    padding: @dp2 @dp10;
}

#repoIssueCard QPushButton[accessibleName="primary"]:hover {
    background-color: @accentHover;
}

#repoRemoveBtn {
    color: @destructiveColor;
    background-color: transparent;
    border: 1px solid @destructiveColor;
    border-radius: @dp4;
    padding: @dp2 @dp10;
}

#repoIssueSummary { font-weight: bold; }
#repoIssueSummary[issueSeverity="error"]   { color: @destructiveColor; }
#repoIssueSummary[issueSeverity="warning"] { color: @warningColor; }

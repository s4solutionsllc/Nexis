/****** ADWAITA THEME ******/

/*****************
    QScrollArea
******************/
QScrollArea {
    border: 0;
}

QScrollBar:vertical {
    width: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:vertical {
    background-color: @color06;
    min-height: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:vertical:hover {
    background-color: @color04;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    height: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:horizontal {
    background-color: @color06;
    min-width: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:horizontal:hover {
    background-color: @color04;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

/*************
    QDialog
**************/
QDialog {
    background-color: @color01;
}

QDialog QLabel {
    color: @color05;
}

QDialog QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    padding: 12 12 6 12;
    background-color: @cardBg;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

/*************
    QMessageBox
**************/
QMessageBox {
    background-color: @color01;
}

QMessageBox QLabel {
    color: @color05;
}

/*************
    QMenu
**************/
QMenu {
    background-color: @color01;
    border-radius: 8;
    border: 1px solid @borderColor;
    padding: 4 0;
}

QMenu::item {
    padding: @dp6 @dp24;
    color: @color05;
    font-size: 10pt;
    border-radius: @dp6;
    margin: @dp2 @dp4;
}

QMenu::item:selected {
    background-color: @accentColor;
    color: @color07;
}

QMenu::indicator {
    width: @dp14px;
    height: @dp14px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QRadioButton
******************/

QRadioButton {
    color: @color12;
    font-size: 11pt;
}

QRadioButton::indicator {
    width: @dp16;
    height: @dp16;
}

QRadioButton::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QRadioButton::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QCheckBox
******************/

QCheckBox {
    color: @color05;
}

QCheckBox::indicator {
    width: @dp44px;
    height: @dp24px;
}

QCheckBox::indicator:checked {
    image: url(:/static/themes/common/img/checkbox.svg);
}

QCheckBox::indicator:unchecked {
    image: url(:/static/themes/common/img/un-checkbox.svg);
}

QCheckBox[accessibleName="circle"] {
    font-size: 10pt;
    color: @color06;
}

QCheckBox[accessibleName="circle"]::indicator {
    width: @dp18px;
    height: @dp18px;
}

QCheckBox[accessibleName="circle"]::indicator:unchecked {
    image: url(:/static/themes/common/img/circle-unchecked.svg);
}

QCheckBox[accessibleName="circle"]::indicator:checked {
    image: url(:/static/themes/common/img/circle-checked.svg);
}

/*****************
    QToolTip
******************/

QToolTip {
    color: @color05;
    padding: 4 8;
    background-color: @color01;
    border: 1px solid @borderColor;
    border-radius: 6;
}

/***************
    Not Found
***************/

#notFoundWidget, QWidget[accessibleName="notFoundWidget"] {
    background: url(:/static/themes/common/img/not-found.png) no-repeat top center;
}

#notFoundWidget QLabel, QWidget[accessibleName="notFoundWidget"] {
    color: @color06;
    font-size: 13pt;
}

/***************
    QSpinBox
***************/

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spinup.svg) 1;
    border-width: 1px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spindown.svg) 1;
    border-width: 1px;
    border-top-width: 0;
}

/***************
    QSlider
***************/

QSlider::groove:horizontal {
    height: 4px;
    background: @borderColor;
    margin: 2px 0;
    border-radius: 2;
}

QSlider::handle:horizontal {
    background-color: @accentColor;
    width: @dp16px;
    height: @dp16px;
    margin: -@dp6px 0;
    border-radius: @dp8px;
}

/***************
    QComboBox
***************/

QComboBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    background-color: @color02;
    padding: @dp6 @dp12;
    font-size: 10pt;
    color: @color05;
    min-width: @dp100;
}

QComboBox:hover {
    border-color: @color04;
}

QComboBox::drop-down {
    background-color: transparent;
    subcontrol-position: top right;
    width: @dp20;
    padding: 0 @dp6;
    border: 0;
    border-top-right-radius: 6;
    border-bottom-right-radius: 6;
}

QComboBox::down-arrow {
    image: url(:/static/themes/common/img/chevron-down.svg);
    width: 10;
    height: 6;
}

QComboBox QAbstractItemView {
    background-color: @color02;
    border: 1px solid @borderColor;
    border-radius: 6;
    color: @color05;
    selection-background-color: @accentColor;
    selection-color: @color07;
}

/***************
    QGroupBox
***************/

QGroupBox::title {
    font-size: 11pt;
    font-weight: bold;
    color: @color06;
}

/***************
    QTableView
***************/

QTableView {
    background-color: transparent;
    selection-color: @color05;
    color: @color05;
    font-size: 10pt;
    gridline-color: @borderColor;
    border-radius: 6;
}

QTableView::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

QTableView::item:selected {
    background-color: @color02;
}

#tableProcess::item {
    font-size: 9pt;
}

QHeaderView::section {
    background-color: @color02;
    border-width: 0 0 1 0;
    border-style: solid;
    border-color: @borderColor;
    font-size: 10pt;
    color: @color04;
    padding: @dp8 @dp12;
}

QHeaderView::up-arrow {
    image: url(:/static/themes/common/img/sort-asc.svg);
    width: 10;
    height: 8;
}

QHeaderView::down-arrow {
    image: url(:/static/themes/common/img/sort-dsc.svg);
    width: 10;
    height: 8;
}

/******************
    QMainWindow
*******************/

QMainWindow * {
    font-family: @fontFamily;
}

QLineEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    padding: @dp8;
    background-color: @color02;
    font-size: 10pt;
    color: @color05;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: @accentColor;
}

QPushButton {
    border-radius: @dp6;
    font-size: 10pt;
    padding: @dp8 @dp16;
    min-height: @dp18;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

QPushButton:hover {
    border-color: @accentColor;
    color: @accentColor;
}

QPushButton[accessibleName="danger"] {
    background-color: @destructiveColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="danger"]:hover {
    background-color: @color09;
}

QPushButton[accessibleName="primary"] {
    background-color: @accentColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="primary"]:hover {
    background-color: @accentHover;
}

QLabel[accessibleName="dialog-title"] {
    color: @color05;
    font-size: 12pt;
    font-weight: bold;
    padding-bottom: 8;
    border: 0;
    border-bottom: 1px solid @borderColor;
}

#lblErrorMsg {
    color: @destructiveColor;
}

/**************
    Sidebar
***************/

#sidebar {
    background-color: @sidebar;
    border-right: 1px solid @borderColor;
}

#sidebar QPushButton {
    border: 0;
    height: @dp32;
    border-radius: @dp6;
    color: @color06;
    margin: 1 @dp8;
    padding: 0 @dp12;
    text-align: left;
    font-size: 10pt;
    border-left: 3px solid transparent;
    background-color: @sidebar;
}

#sidebar QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    font-weight: 600;
    border-left: 3px solid @accentColor;
}

#sidebar QPushButton:hover:!checked {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @borderColor;
}

/* Section toggle headers (collapsible groups) */
#sidebar #sectionToggle {
    font-size: 8pt;
    font-weight: 600;
    color: @tertiaryText;
    padding: 12px 12px 4px 20px;
    text-transform: uppercase;
    border: 0;
    border-top: 1px solid @borderColor;
    margin-top: 6px;
    background: transparent;
    text-align: left;
}

#sidebar #sectionToggle:hover {
    color: @color05;
    background-color: transparent;
}

/* Sidebar logo */
#sidebarLogo {
    background: transparent;
    border: 0;
}

/* Sidebar toggle button */
#btnSidebarToggle {
    border: 0;
    border-radius: @dp4;
    background: transparent;
    padding: 0;
}

#btnSidebarToggle:hover {
    background-color: @color02;
}

/* Collapsed sidebar overrides */
#sidebar[collapsed="true"] QPushButton {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 3px solid transparent;
}

#sidebar[collapsed="true"] QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    border-left: 0;
    border-bottom: 3px solid @accentColor;
}

#sidebar[collapsed="true"] QPushButton:hover:!checked {
    border-left: 0;
    border-bottom: 3px solid @borderColor;
}

#sidebar[collapsed="true"] #btnSidebarToggle {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 0;
}

#sidebar[collapsed="true"] #sectionToggle {
    border-top: 0;
    margin-top: 0;
    padding: 0;
    max-height: 0;
}

#sidebarDividerLine {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 4 12;
}

/* Sidebar scroll area — transparent so sidebar background shows through */
#sidebarScrollArea, #sidebarScrollArea > QWidget, #sidebarNavContainer {
    background: transparent;
    border: 0;
}

/* Thin scrollbar rail, only visible when nav content overflows */
#sidebarScrollArea QScrollBar:vertical {
    background: transparent;
    width: 4px;
    margin: 0;
}
#sidebarScrollArea QScrollBar::handle:vertical {
    background: @color04;
    border-radius: 2px;
    min-height: 20px;
}
#sidebarScrollArea QScrollBar::handle:vertical:hover {
    background: @color05;
}
#sidebarScrollArea QScrollBar::add-line:vertical,
#sidebarScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}

#sidebarVersionLabel {
    color: @tertiaryText;
    font-size: 8pt;
    padding: 0 12;
}

#sidebarBadge {
    background-color: @accentColor;
    color: @color07;
    font-size: 7pt;
    font-weight: 700;
    border-radius: 8;
    padding: 1 6;
    min-width: 16;
    max-height: 16;
}

#sidebarBadgeDot {
    background-color: @accentColor;
    border-radius: 4;
    min-width: 8;
    max-width: 8;
    min-height: 8;
    max-height: 8;
}

#updatesBadge {
    background-color: @updatesColor;
    color: @color07;
    font-size: 7pt;
    font-weight: 700;
    border-radius: 8;
    padding: 1 6;
    min-width: 16;
    max-height: 16;
}

#updatesBadgeDot {
    background-color: @updatesColor;
    border-radius: 4;
    min-width: 8;
    max-width: 8;
    min-height: 8;
    max-height: 8;
}

#sidebarSectionIndicator {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 2 16;
}

/********************
    COMMAND PALETTE
*********************/

#commandPaletteInner {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#commandPaletteSearch {
    background-color: @color01;
    color: @color05;
    border: 0;
    border-bottom: 1px solid @borderColor;
    border-radius: 12px 12px 0 0;
    padding: 14 16;
    font-size: 13pt;
}

#commandPaletteSearch:focus {
    border-bottom: 1px solid @accentColor;
}

#commandPaletteResults {
    background-color: transparent;
    border: 0;
    padding: 4 0;
}

#commandPaletteResults::item {
    color: @color06;
    padding: 8 16;
    border: 0;
    font-size: 10pt;
}

#commandPaletteResults::item:selected {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @accentColor;
}

#commandPaletteResults::item:hover:!selected {
    background-color: @color02;
}

#commandPaletteFooter {
    border-top: 1px solid @borderColor;
    background-color: @color01;
}

#commandPaletteKey {
    font-family: @monoFontFamily;
    font-size: 8pt;
    color: @tertiaryText;
    padding: 1 4;
    border: 1px solid @borderColor;
    border-radius: 4;
    background-color: @color02;
}

#commandPaletteHintLabel {
    font-size: 8pt;
    color: @tertiaryText;
}

#pageContent {
    background-color: @pageContent;
}

/********************
    DASHBOARD PAGE
*********************/

/* - Circle Bar - */

#widgetCircleBar {
    background-color: @cardBg;
    border-radius: 12;
}

#lblCircleChartTitle,
#lblCircleChartValue {
    color: @color05;
    font-size: 13pt;
    margin: 0;
}

/* - Line Bar - */

#lineChartWidget {
    background-color: @cardBg;
    border-radius: 12;
}

#lblLineChartTitle {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartValue {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartTotal {
    color: @color06;
    font-size: 10pt;
}

#lineChartProgress {
    background-color: @color02;
    border: 0;
    border-radius: 3;
    max-height: 6;
}

#lineChartProgress::chunk {
    background-color: @accentColor;
    border-radius: 3;
}

/* - Elevated Card / Flat Card (shared recipe, DS §2, NEX F1) - */
/*
 * Generalizes the Dashboard tile chrome (dashboard_tile_wrapper.cpp
 * applyDepthTreatment(), reference-only) into a reusable QSS pattern so
 * page items style through the global stylesheet instead of one-off
 * per-widget setStyleSheet() calls (DS §9 item 1).
 *
 * Usage for a consuming page item:
 *   - Give the container widget an object name of "<page>Container"
 *     (elevated) or "<page>Card" (flat) — identifies the widget for any
 *     page-specific child selectors; it does not itself style the card.
 *   - setAttribute(Qt::WA_StyledBackground, true) on that widget so QSS
 *     paints its background/border (Qt does not style plain QWidgets by
 *     default).
 *   - setProperty("cardRole", "elevated") or setProperty("cardRole",
 *     "flat") on the same widget to opt into this recipe via the property
 *     selectors below — mirrors the existing [status="..."] convention
 *     (style.qss "Status property selectors").
 *   - Elevated containers only: call Utilities::addDropShadow(widget, 90,
 *     26) once per container instance (never per row/child — DS §7), and
 *     give the container an 8px outer margin (e.g.
 *     layout->setContentsMargins(8, 8, 8, 8) on its parent layout) for
 *     shadow clearance.
 *   - Flat cards nest inside an elevated container and carry no shadow.
 */

[cardRole="elevated"] {
    background-color: @cardBgElevated;
    border-radius: 12;
    border: 1px solid @borderColor;
}

[cardRole="flat"] {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

/* - Empty State (shared recipe, DS §5, NEX F3) - */
/*
 * Icon + explanation + next-action pattern for empty data states
 * [NNG-EMPTY]. The composite widget nests inside the page's existing
 * flat/elevated card (DS §2, [cardRole] above) — it does not draw its own
 * card chrome, only the icon/text/action children below.
 *
 * Usage for a consuming page item:
 *   - Container widget: objectName "<page>EmptyState" (e.g.
 *     "processesEmptyState"), added to the selector group below so it
 *     stays transparent over the surrounding card fill.
 *   - Icon: a QLabel with objectName "emptyStateIcon".
 *   - Explanation: a QLabel with objectName "emptyStateText" (muted
 *     @tertiaryText, matches DS §5).
 *   - Next action: a QPushButton — reuses the global QPushButton recipe
 *     (style.qss:400-408) or QPushButton[accessibleName="primary"]
 *     (style.qss:426-434) for emphasis; no new button selector needed
 *     (DS §9 item 1, QSS-first).
 *   - No per-frame animation on the icon or any empty-state child
 *     (DS §9 item 2).
 *   - Known consumers (Phase-2 page items, not yet implemented): Processes
 *     (list icon, "Refresh now"), Search (search icon, "No results yet" +
 *     hint), Disk Tools (disk icon, "Scan"), Boot Analysis (clock icon,
 *     "Refresh uptime" — upgrades #lblBootEmptyState;
 *     boot_analysis_page.cpp is not touched by this item). Extend the
 *     selector group below with each page's actual objectName as it lands.
 */

#processesEmptyState, #searchEmptyState, #diskToolsEmptyState, #bootAnalysisEmptyState {
    background: transparent;
}

#emptyStateIcon {
    color: @tertiaryText;
    font-size: 28pt;
}

#emptyStateText {
    color: @tertiaryText;
    font-size: 9pt;
}

/* - Loading Skeleton (shared recipe, DS §5, DS §9 item 2) - */
/*
 * Static placeholder block for loading states. Explicitly no animation, no
 * QTimer-driven repaint (DS §9 item 2) — apply/remove this property when
 * the real content is ready instead of pulsing or shimmering it. No page
 * consumes this yet; a dynamic-property selector (mirrors [cardRole] and
 * [status] above) rather than a per-page ID, since loading placeholders can
 * appear anywhere a page fetches data asynchronously.
 *
 * Usage: setProperty("loadingState", "skeleton") on a placeholder widget
 * standing in for not-yet-loaded content; unpolish()/polish() after
 * clearing the property once real content is ready (BUG-56, DS §8).
 */

[loadingState="skeleton"] {
    background-color: @chartGridColor;
    border-radius: 4;
}

/* - Metric Tile - */

#metricTile, #gaugeTile, #ringTile, #hybridTile, #speedometerTile, #vuMeterTile, #healthScoreTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#metricTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#metricTileInput {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 500;
}

#metricTileValue {
    color: @color05;
    font-size: 14pt;
    font-weight: 700;
}

#metricTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

#metricTileHeader, #metricTileFooter {
    background-color: transparent;
}

#metricTileSource {
    color: @tertiaryText;
    font-size: 8pt;
}

#metricTileAccent {
    background-color: @borderColor;
    border-radius: 1;
}

#metricTileTrend {
    color: @tertiaryText;
    font-size: 8pt;
    padding: 1 6;
    border-radius: 8;
    background-color: @chartGridColor;
}

#metricTileProgress {
    background-color: @chartGridColor;
    border: 0;
    border-radius: 2;
    max-height: 4;
}

#metricTileProgress::chunk {
    border-radius: 2;
}

#metricTileAction {
    font-size: 8pt;
    padding: 2 8;
    border-radius: 10;
    background: transparent;
}

/* - Section Header (shared recipe, DS §3, NEX F2) - */
/*
 * Generalizes the Dashboard tile header (metric_tile_base.cpp buildChrome(),
 * reference-only) into a reusable QSS pattern so page toolbars/section
 * titles style through the global stylesheet instead of one-off per-widget
 * setStyleSheet() calls (DS §9 item 1) — same approach as the Elevated/Flat
 * Card recipe above (NEX F1).
 *
 * Usage for a consuming page item:
 *   - Header row: a QWidget/QHBoxLayout holding the accent bar + text
 *     column (title row + source row), objectName "sectionHeaderRow".
 *   - Accent bar: a QFrame, objectName "sectionHeaderAccent",
 *     setFixedWidth(3) at construction (width is not stylable via QSS —
 *     mirrors #metricTileAccent, which also only sets background-color /
 *     border-radius here). Give it a "accentToken" dynamic property set to
 *     one of the values below to pick a type-appropriate color instead of a
 *     hardcoded hex (BUG-47); omit the property for the neutral default.
 *     BUG-56: if "accentToken" changes on an already-shown widget (e.g. a
 *     theme-dependent metric type), call
 *     style()->unpolish(widget); style()->polish(widget); to force Qt to
 *     re-evaluate the property selector.
 *   - Title row: title label objectName "sectionHeaderTitle", optional meta
 *     label objectName "sectionHeaderMeta", a layout stretch, then an
 *     optional top-right action button objectName "sectionHeaderAction"
 *     (QToolButton, fixed size 24x24, icon size 14x14, setAutoRaise(true) —
 *     mirrors createGearButton(), metric_tile_base.cpp:171-180).
 *   - Source row: muted label objectName "sectionHeaderSource" beneath the
 *     title row.
 *   - Root layout margins (14, 12, 14, 10), root spacing 6, header-row
 *     spacing 8, and a fixed-height 24px footer band (FOOTER_HEIGHT,
 *     metric_tile_base.h:65) are set in the consuming page's C++ layout
 *     code, not QSS — match those values for visual parity with the
 *     Dashboard tile header (DS §3).
 *   - Settings section-card variant: set a "compact" dynamic property
 *     (true) on the accent bar for the shorter ≥18px card-header bar
 *     instead of the ≥26px page/tile-header bar.
 *   - Pages with no existing title in the approved capture (Search, System
 *     Logs, Disk Tools, Uninstaller) apply this pattern as spacing/
 *     alignment chrome only via #sectionHeaderRow — do not add
 *     #sectionHeaderTitle/#sectionHeaderAccent where the capture had none.
 */

#sectionHeaderRow {
    background-color: transparent;
}

#sectionHeaderAccent {
    background-color: @borderColor;
    border-radius: 1;
    min-height: 26;
}

#sectionHeaderAccent[compact="true"] {
    min-height: 18;
}

#sectionHeaderAccent[accentToken="cpu"] {
    background-color: @cpuColor;
}

#sectionHeaderAccent[accentToken="gpu"] {
    background-color: @gpuColor;
}

#sectionHeaderAccent[accentToken="memory"] {
    background-color: @memoryColor;
}

#sectionHeaderAccent[accentToken="disk"] {
    background-color: @diskColor;
}

#sectionHeaderAccent[accentToken="network"] {
    background-color: @networkColor;
}

/* SSO-13732 (System Cleaner): "success" accent token for the page header
   bar, matching the "Estimated recoverable" @successColor readout. */
#sectionHeaderAccent[accentToken="success"] {
    background-color: @successColor;
}

#sectionHeaderAccent[accentToken="accent"] {
    background-color: @accentColor;
}

#sectionHeaderTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#sectionHeaderMeta {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 500;
}

#sectionHeaderSource {
    color: @tertiaryText;
    font-size: 8pt;
}

#sectionHeaderAction {
    border: 0;
    background-color: transparent;
    border-radius: 4;
    padding: 0;
}

#sectionHeaderAction:hover {
    background-color: @color02;
}

#sectionHeaderAction::menu-indicator {
    width: 0;
    height: 0;
}

/* - Disk Donut Tile - */

#diskTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#diskTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#diskTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

#diskHealthStatus {
    font-size: 9pt;
    font-weight: 600;
}

#btnDiskGear {
    border: 0;
    background-color: transparent;
    border-radius: 4;
    padding: 0;
}

#btnDiskGear:hover {
    background-color: @color02;
}

#btnDiskGear::menu-indicator {
    width: 0;
    height: 0;
}

/* - Network Tile - */

#networkTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#networkTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#networkDivider {
    background-color: @borderColor;
    border: 0;
    max-height: 1;
    margin: 4 0;
}

#networkTileLabel {
    font-size: 9pt;
    font-weight: 600;
}

#networkTileValue {
    color: @color05;
    font-size: 13pt;
    font-weight: 700;
}

#networkTileFooter {
    color: @tertiaryText;
    font-size: 8pt;
}

#networkTileInterface {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - Edit Mode Toolbar - */

#editToolbar {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
}

#editToolbarLabel {
    color: @color05;
    font-size: 10pt;
    font-weight: 600;
}

#btnEditToggle {
    border: 0;
    background-color: transparent;
    border-radius: 6;
    padding: 4;
}

#btnEditToggle:hover {
    background-color: @color02;
}

#btnResetLayout {
    font-size: 9pt;
    padding: 4 12;
    border-radius: 6;
    border: 1px solid @borderColor;
    color: @color05;
    background-color: transparent;
}

#btnResetLayout:hover {
    background-color: @color02;
}

#btnEditDone {
    font-size: 9pt;
    padding: 4 12;
    border-radius: 6;
    border: 1px solid @accentColor;
    color: @color07;
    background-color: @accentColor;
}

#btnEditDone:hover {
    background-color: @accentHover;
}

#dragIndicator {
    background-color: @accentColor;
    border: 2px solid @accentColor;
    border-radius: 12;
}

#dashPlaceholder {
    background-color: transparent;
    border: @dp1 dashed @borderColor;
    border-radius: @dp8;
}

/* - System Summary Card - */

#systemSummaryCard {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#summaryLabel {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 600;
}

#summaryValue {
    color: @color05;
    font-size: 10pt;
}

/* - Status Footer - */

#statusFooter {
    background-color: @sidebar;
    border-top: 1px solid @borderColor;
    border-radius: 0;
}

#statusFooter QLabel {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - Temperature Gauge - */

#tempContainer {
    background-color: @cardBg;
    border-radius: 12;
}

#btnMetricGear {
    border: 0;
    background-color: transparent;
    border-radius: 4;
    padding: 0;
}

#btnMetricGear:hover {
    background-color: @color02;
}

#btnMetricGear::menu-indicator {
    width: 0;
    height: 0;
}

/* - Kiosk Toggle Button - */

#btnKioskToggle {
    border: 0;
    background-color: transparent;
    border-radius: @dp4;
}

#btnKioskToggle:hover {
    background-color: @color02;
}


/**************************
    HARDWARE INFO PAGE
***************************/

#HardwareInfoPage {
    background-color: transparent;
}

#HardwareInfoPage #scrollArea,
#HardwareInfoPage #scrollContent {
    background-color: transparent;
}

#HardwareInfoPage QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    background-color: @cardBg;
}

#HardwareInfoPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

#HardwareInfoPage QTableWidget {
    background-color: transparent;
    border: 0;
}

#HardwareInfoPage QTableWidget::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

/**************************
    SYSTEM CLEANER PAGE
***************************/

/* Page header (title/source line) now uses the shared #sectionHeaderTitle /
   #sectionHeaderSource recipe (DS §3, NEX F2) — see buildCategoryHeader(). */

/* - Category cards (DS §2 elevated tile, NEX F1 shared recipe) - */
/* Background/border/radius come from [cardRole="elevated"]
   (style.qss "Elevated Card / Flat Card" recipe); this block only adds the
   checked-state accent border and the card's own child-label typography. */

#cleanerCategoryCard[checked="true"] {
    border: 2px solid @accentColor;
}

#cleanerCategoryCard #lblCatName {
    font-size: 10pt;
    font-weight: 600;
    color: @color05;
}

#cleanerCategoryCard #lblCatSubtitle {
    font-size: 8pt;
    color: @color06;
    font-family: @monoFontFamily;
}

#cleanerCategoryCard #lblCatSize {
    font-size: 9pt;
    color: @color06;
}

/* - Scan progress bar - */

/* DS §6 static progress recipe: track @chartGridColor, fill @accentColor,
   radius 2, height 4 (set via setFixedHeight() in onBtnScanSystemClicked()). */
#cleanerScanProgress {
    background-color: @chartGridColor;
    border: none;
    border-radius: 2;
}

#cleanerScanProgress::chunk {
    background-color: @accentColor;
    border-radius: 2;
}

/* - Header action buttons - */

#btnScheduleCleaner {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    background-color: transparent;
    color: @color05;
    padding: @dp6 @dp14;
}

#btnScheduleCleaner:hover {
    background-color: @cardBg;
}

#btnScanSystem {
    border: 0;
    border-radius: @dp6;
    background-color: @accentColor;
    color: @color07;
    font-weight: 700;
    padding: @dp6 @dp16;
}

#btnScanSystem:hover {
    background-color: @accentHover;
}

/* - Footer bar - */

#cleanerFooter {
    background-color: @cardBgElevated;
    border: 1px solid @borderColor;
    border-radius: 8;
}

#lblEstimatedLabel {
    font-size: 7pt;
    color: @color06;
}

#lblEstimatedSize {
    font-size: 13pt;
    font-weight: 700;
    color: @successColor;
}

/* Primary action, matching #btnScanSystem — deletion is confirmed by the
   scan results the user has already reviewed, not a bare destructive action. */
#btnCleanSelected {
    border: 0;
    border-radius: @dp6;
    background-color: @accentColor;
    color: @color07;
    font-weight: 700;
    padding: @dp6 @dp16;
}

#btnCleanSelected:hover {
    background-color: @accentHover;
}

#btnCleanSelected:disabled {
    background-color: @color14;
    color: @color06;
}

#btnViewResults {
    border: 0;
    background: transparent;
    color: @accentColor;
    font-size: 9pt;
}

#btnViewResults:hover {
    color: @accentHover;
}

/* - System Clean Button (page 1 tree results) - */

#SystemCleanerPage #btnClean {
    border: 0;
    background: url(:/static/themes/@themeName/img/clean.png) no-repeat center;
}

#SystemCleanerPage #btnClean:hover {
    background: url(:/static/themes/@themeName/img/clean-active.png) no-repeat center;
}

/* - System Scan Results - */

#btnBackToCategories {
    border: 0;
    font-size: 11pt;
    color: @accentColor;
    background-color: @accentBgTint;
}

#lblSortBy {
    font-size: 9pt;
    color: @color06;
}

#cbSortBy {
    font-size: 9pt;
    min-width: 0;
}

#treeWidgetScanResult {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-family: @fontFamily;
}

#treeWidgetScanResult QHeaderView::section {
    border-top: 1;
    font-size: 9pt;
}

#treeWidgetScanResult::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    color: @color11;
}

#treeWidgetScanResult::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetScanResult::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetScanResult::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetScanResult::branch:has-children:!has-siblings:closed,
#treeWidgetScanResult::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch:open:has-children:!has-siblings,
#treeWidgetScanResult::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch {
    border-bottom: 1px solid @borderColor;
}

#lblRemovedTotalSize {
    font-size: 11pt;
    color: @successColor;
}

#lblTotalBytes {
    font-size: 11pt;
    color: @color05;
}

/* - Schedule Indicator - */

#scheduleIndicator {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
    padding: 8;
}

#lblNextSchedule {
    font-size: 10pt;
    color: @color05;
}

#lblLastSchedule {
    font-size: 9pt;
    color: @color06;
}

#lblSnapshotToast {
    color: @successColor;
    border-left: 3px solid @successColor;
    padding: 4px 10px;
    font-size: 9pt;
}

#lblExclusionNotice {
    color: @color05;
    padding: 6px 0;
}

/************************
    STARTUP APPS PAGE
*************************/
/* DS §2/§7 (NEX F1, SSO-13738): #startupAppsContainer carries the single
   elevated shadow ([cardRole="elevated"], NEX F1 recipe); the list itself
   stays transparent so the container surface shows through, and each row
   (#widgetStartupApp / #widgetBtmRow) is a flat @cardBg strip, never
   shadowed on its own. */
#listWidgetStartup {
    background-color: transparent;
}

/************************
    BOOT ANALYSIS PAGE
*************************/
#lblBootAnalysisTitle {
    color: @color11;
    padding: 10 0 4 0;
}

#lblBootAnalysisSubtitle {
    color: @color11;
    padding: 0 0 4 0;
}

#lblBootEmptyState {
    color: @color04;
    font-size: 11pt;
    qproperty-alignment: AlignCenter;
}

/* - Startup App - */

/* GNOME-HIG grouped-list convention (DS §7): flush flat rows, divided by a
   bottom border instead of the old per-row rounded card + gap. */
#widgetStartupApp {
    background-color: @cardBg;
    border: 0;
    border-bottom: 1px solid @borderColor;
}

#lblStartupAppIcon {
    image: url(:/static/themes/@themeName/img/app.png);
}

#widgetStartupApp:hover {
    background-color: @accentBgTint;
}

/* DS §4 title role */
#widgetStartupApp #lblStartupAppName {
    font-size: 9pt;
    font-weight: 600;
    color: @color06;
}

#checkStartup {
    margin-top: 3;
}

#widgetStartupApp #btnDeleteStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/trash.png);
    border: 0;
}

#widgetStartupApp #btnEditStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/edit.png);
    border: 0;
    margin-bottom: 2;
}

/* Muted uppercase group label ("User Agents" / "System Agents") between
   flat rows [GNOME-HIG]. */
#startupSectionHeader {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 600;
    text-transform: uppercase;
    padding: @dp12 @dp16 @dp6;
    background-color: @cardBg;
}

/* DS §4 meta role */
#widgetStartupApp #lblStartupAppPath {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 500;
    font-family: @monoFontFamily;
}

/* - BTM (Background Task Management) rows — SSO-3738 - */

#widgetBtmRow {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#widgetBtmRow #lblBtmRowName {
    color: @color05;
    font-size: 10pt;
    font-weight: 600;
}

#widgetBtmRow #lblBtmRowSubtext {
    color: @tertiaryText;
    font-size: 9pt;
    font-family: @monoFontFamily;
}

#widgetBtmRow QLabel[badge="true"] {
    padding: @dp2 @dp6;
    border-radius: @dp4;
    font-size: 9pt;
    font-weight: 600;
    background-color: @cardBgElevated;
    color: @tertiaryText;
}

#widgetBtmRow #btmBadgeOn {
    background-color: @successColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeOff {
    background-color: @cardBgElevated;
    color: @tertiaryText;
}

#widgetBtmRow #btmBadgeOrphan {
    background-color: @destructiveColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeDuplicate {
    background-color: @warningColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeApple {
    background-color: @infoColor;
    color: @overlayText;
}

#btnRepairBtm {
    background-color: @destructiveColor;
    color: @overlayText;
    border-radius: @dp4;
    padding: @dp6 @dp10;
    font-weight: 600;
}

#btnRepairBtm:hover {
    background-color: @accentHover;
}

/* - Startup App Edit - */

#StartupAppEdit {
    background-color: @pageContent;
}

/**************************
    SERVICES PAGE
***************************/

#ServicesPage QListWidget {
    background-color: transparent;
}

#lblServicesTitle {
    font-size: 11pt;
    color: @color11;
    padding: 10 0;
}

/* - Service Item - */

#serviceItemWidget {
    border-radius: 12;
    background-color: @cardBg;
    border: 1px solid transparent;
}

#serviceItemWidget:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}


#ServiceItem #lblServiceName {
    font-size: 10pt;
    color: @color05;
    font-family: @monoFontFamily;
}

#ServiceItem #lblServiceDescription {
    font-size: 9pt;
    color: @color06;
    font-family: @monoFontFamily;
}

#ServiceItem #checkServiceRunning {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 600;
    min-width: 60px;
    max-width: 80px;
    spacing: 0px;
}

#ServiceItem #checkServiceRunning::indicator {
    width: 0px;
    height: 0px;
}

#ServiceItem #checkServiceRunning:checked {
    background-color: @successColor;
    color: @color07;
}

#ServiceItem #checkServiceRunning:!checked {
    background-color: @color02;
    color: @color04;
    border: 1px solid @borderColor;
}

#lblServiceStartupImg {
    image: url(:/static/themes/@themeName/img/power.svg);
}

#lblSystemRunningImg {
    image: url(:/static/themes/@themeName/img/run.svg);
}

/**********************
    PROCESSES PAGE
***********************/

#lblProcessTitle {
    color: @color11;
    padding: 10 0;
    font-size: 11pt;
}

#checkAllProcesses {
    margin-top: 2;
    color: @color12;
    font-size: 10pt;
}

#checkAllProcesses::indicator {
    width: @dp14;
    height: @dp14;
}

#txtProcessSearch {
    width: @dp180;
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

#lblRefresh {
    color: @color12;
    font-size: 10pt;
}

#sliderRefresh {
    margin-top: 3;
}

/************************
    UNINSTALLER PAGE
*************************/

#nav QPushButton {
    border-radius: @dp6;
    padding: @dp6 @dp12;
    font-size: 10pt;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

#nav QPushButton:hover,
#nav QPushButton:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

/**************************
    HELPERS PAGE
***************************/
#lblToolsSection, #lblMaintenanceSectionHeader {
    font-size: 8pt;
    font-weight: 600;
    color: @color04;
}

#maintenanceCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
    padding: 8 12;
}

#maintenanceCard:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#maintenanceCard #lblCardTitle {
    font-size: 10pt;
    font-weight: 600;
}

#maintenanceCard #lblCardDesc {
    font-size: 8pt;
    color: @color06;
}

/* - Search field (shared: Uninstaller / APT Source Manager / Homebrew) - */
#txtPackageSearch,
#txtSearchAptSource {
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

/* -- Package tree (Uninstaller + Homebrew) -- table style matching System Cleaner -- */

#treeWidgetPackages {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetPackages QHeaderView::section {
    border-top: 1;
}

#treeWidgetPackages::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetPackages::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetPackages::branch:has-children:!has-siblings:closed,
#treeWidgetPackages::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch:open:has-children:!has-siblings,
#treeWidgetPackages::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Available Updates tree (FR-60) -- matching treeWidgetPackages -- */

#treeWidgetUpdates {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetUpdates QHeaderView::section {
    border-top: 1;
}

#treeWidgetUpdates::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

/* -- Snap package list (card style, unchanged) -- */

#listWidgetSnapPackages {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#listWidgetSnapPackages::indicator {
    width: @dp16;
    height: @dp16;
}

#listWidgetSnapPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#listWidgetSnapPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#listWidgetSnapPackages::item {
    border-radius: @dp8;
    min-height: @dp36;
    background-color: @cardBg;
    margin: 1 0;
}

#listWidgetSnapPackages::item:text {
    color: @color05;
    padding-left: @dp12;
}

#listWidgetSnapPackages::item:selected {
    background-color: @color02;
    border: 0;
}

#listWidgetSnapPackages::item:hover {
    background-color: @color02;
}

/* -- Orphan package list (matching snap package style) -- */

#listWidgetOrphanPackages {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#listWidgetOrphanPackages::indicator {
    width: @dp16;
    height: @dp16;
}

#listWidgetOrphanPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#listWidgetOrphanPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#listWidgetOrphanPackages::item {
    border-radius: @dp8;
    min-height: @dp36;
    background-color: @cardBg;
    margin: 1 0;
}

#listWidgetOrphanPackages::item:text {
    color: @color05;
    padding-left: @dp12;
}

#listWidgetOrphanPackages::item:selected {
    background-color: @color02;
    border: 0;
}

#listWidgetOrphanPackages::item:hover {
    background-color: @color02;
}

/**************************
    DISK TOOLS PAGE
***************************/

/* NEX Phase-2 "Disk Tools" page item (SSO-13739): the scan-roots list and
   the results tree (per mode) each sit inside their own DS §2 elevated
   container ([cardRole="elevated"], NEX F1, shadow via
   DiskToolsPage::makeElevatedContainer()); rows below stay flat (DS §7 —
   shadow lives on the container, never per row). */

/* Mode tabs — DS §3 header-anatomy spacing (#sectionHeaderRow); no title
   label in the approved capture, so this page applies the pattern as
   spacing/alignment chrome only (style.qss "Section Header" doc comment).
   Active tab uses @accentColor. */

#DiskToolsPage QPushButton#segmentedLeft,
#DiskToolsPage QPushButton#segmentedRight {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: @dp8;
    padding: @dp8 @dp16;
    font-size: 10pt;
    font-weight: 600;
}

#DiskToolsPage QPushButton#segmentedLeft:checked,
#DiskToolsPage QPushButton#segmentedRight:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#DiskToolsPage QPushButton#segmentedLeft:hover:!checked,
#DiskToolsPage QPushButton#segmentedRight:hover:!checked {
    border-color: @accentColor;
}

/* Directory picker lists — flat rows inside their elevated container */

#diskToolsDirList {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
    color: @color05;
}

#diskToolsDirList::item {
    padding: @dp10 @dp12;
    color: @color05;
    border-bottom: 1px solid @borderColor;
    font-family: @monoFontFamily;
}

#diskToolsDirList::item:selected {
    background-color: @color02;
}

/* Large & Old results tree — frozen elevated-surface header, flat rows */

#treeWidgetLargeOld {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#treeWidgetLargeOld QHeaderView::section {
    background-color: @cardBgElevated;
    border-top: 0;
    border-bottom: 1px solid @borderColor;
}

#treeWidgetLargeOld::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetLargeOld::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetLargeOld::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetLargeOld::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

/* Duplicate Finder results tree — frozen elevated-surface header, flat rows */

#treeWidgetDuplicates {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#treeWidgetDuplicates QHeaderView::section {
    background-color: @cardBgElevated;
    border-top: 0;
    border-bottom: 1px solid @borderColor;
}

#treeWidgetDuplicates::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetDuplicates::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetDuplicates::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetDuplicates::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetDuplicates::branch:has-children:!has-siblings:closed,
#treeWidgetDuplicates::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetDuplicates::branch:open:has-children:!has-siblings,
#treeWidgetDuplicates::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetDuplicates::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Docker tree widgets (Images / Containers / Volumes) -- */

#treeWidgetImages,
#treeWidgetContainers,
#treeWidgetVolumes {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetImages QHeaderView::section,
#treeWidgetContainers QHeaderView::section,
#treeWidgetVolumes QHeaderView::section {
    border-top: 1;
}

#treeWidgetImages::item,
#treeWidgetContainers::item,
#treeWidgetVolumes::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetImages::indicator,
#treeWidgetContainers::indicator,
#treeWidgetVolumes::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetImages::indicator:unchecked,
#treeWidgetContainers::indicator:unchecked,
#treeWidgetVolumes::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetImages::indicator:checked,
#treeWidgetContainers::indicator:checked,
#treeWidgetVolumes::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetImages::branch:has-children:!has-siblings:closed,
#treeWidgetImages::branch:closed:has-children:has-siblings,
#treeWidgetContainers::branch:has-children:!has-siblings:closed,
#treeWidgetContainers::branch:closed:has-children:has-siblings,
#treeWidgetVolumes::branch:has-children:!has-siblings:closed,
#treeWidgetVolumes::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetImages::branch:open:has-children:!has-siblings,
#treeWidgetImages::branch:open:has-children:has-siblings,
#treeWidgetContainers::branch:open:has-children:!has-siblings,
#treeWidgetContainers::branch:open:has-children:has-siblings,
#treeWidgetVolumes::branch:open:has-children:!has-siblings,
#treeWidgetVolumes::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetImages::branch,
#treeWidgetContainers::branch,
#treeWidgetVolumes::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Helper Widgets (Firewall / Open Ports / Network Diagnostics) -- */

/* Firewall Widget */

#fwStatusDot {

    font-size: 14px;
    font-weight: bold;
}

#fwToggle {
    background-color: @accentColor;
    color: @color07;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

#fwToggle:hover {
    opacity: 0.9;
}

#fwToggle:disabled {

/****** ADWAITA THEME ******/

/*****************
    QScrollArea
******************/
QScrollArea {
    border: 0;
}

QScrollBar:vertical {
    width: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:vertical {
    background-color: @color06;
    min-height: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:vertical:hover {
    background-color: @color04;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    height: @dp8;
    margin: 0;
    border-radius: @dp4;
    background-color: transparent;
}

QScrollBar::handle:horizontal {
    background-color: @color06;
    min-width: @dp30px;
    border-radius: @dp4;
}

QScrollBar::handle:horizontal:hover {
    background-color: @color04;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

/*************
    QDialog
**************/
QDialog {
    background-color: @color01;
}

QDialog QLabel {
    color: @color05;
}

QDialog QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    padding: 12 12 6 12;
    background-color: @cardBg;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

/*************
    QMessageBox
**************/
QMessageBox {
    background-color: @color01;
}

QMessageBox QLabel {
    color: @color05;
}

/*************
    QMenu
**************/
QMenu {
    background-color: @color01;
    border-radius: 8;
    border: 1px solid @borderColor;
    padding: 4 0;
}

QMenu::item {
    padding: @dp6 @dp24;
    color: @color05;
    font-size: 10pt;
    border-radius: @dp6;
    margin: @dp2 @dp4;
}

QMenu::item:selected {
    background-color: @accentColor;
    color: @color07;
}

QMenu::indicator {
    width: @dp14px;
    height: @dp14px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QRadioButton
******************/

QRadioButton {
    color: @color12;
    font-size: 11pt;
}

QRadioButton::indicator {
    width: @dp16;
    height: @dp16;
}

QRadioButton::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

QRadioButton::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

/*****************
    QCheckBox
******************/

QCheckBox {
    color: @color05;
}

QCheckBox::indicator {
    width: @dp44px;
    height: @dp24px;
}

QCheckBox::indicator:checked {
    image: url(:/static/themes/common/img/checkbox.svg);
}

QCheckBox::indicator:unchecked {
    image: url(:/static/themes/common/img/un-checkbox.svg);
}

QCheckBox[accessibleName="circle"] {
    font-size: 10pt;
    color: @color06;
}

QCheckBox[accessibleName="circle"]::indicator {
    width: @dp18px;
    height: @dp18px;
}

QCheckBox[accessibleName="circle"]::indicator:unchecked {
    image: url(:/static/themes/common/img/circle-unchecked.svg);
}

QCheckBox[accessibleName="circle"]::indicator:checked {
    image: url(:/static/themes/common/img/circle-checked.svg);
}

/*****************
    QToolTip
******************/

QToolTip {
    color: @color05;
    padding: 4 8;
    background-color: @color01;
    border: 1px solid @borderColor;
    border-radius: 6;
}

/***************
    Not Found
***************/

#notFoundWidget, QWidget[accessibleName="notFoundWidget"] {
    background: url(:/static/themes/common/img/not-found.png) no-repeat top center;
}

#notFoundWidget QLabel, QWidget[accessibleName="notFoundWidget"] {
    color: @color06;
    font-size: 13pt;
}

/***************
    QSpinBox
***************/

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spinup.svg) 1;
    border-width: 1px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: @dp16px;
    border-image: url(:/static/themes/common/img/spindown.svg) 1;
    border-width: 1px;
    border-top-width: 0;
}

/***************
    QSlider
***************/

QSlider::groove:horizontal {
    height: 4px;
    background: @borderColor;
    margin: 2px 0;
    border-radius: 2;
}

QSlider::handle:horizontal {
    background-color: @accentColor;
    width: @dp16px;
    height: @dp16px;
    margin: -@dp6px 0;
    border-radius: @dp8px;
}

/***************
    QComboBox
***************/

QComboBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    background-color: @color02;
    padding: @dp6 @dp12;
    font-size: 10pt;
    color: @color05;
    min-width: @dp100;
}

QComboBox:hover {
    border-color: @color04;
}

QComboBox::drop-down {
    background-color: transparent;
    subcontrol-position: top right;
    width: @dp20;
    padding: 0 @dp6;
    border: 0;
    border-top-right-radius: 6;
    border-bottom-right-radius: 6;
}

QComboBox::down-arrow {
    image: url(:/static/themes/common/img/chevron-down.svg);
    width: 10;
    height: 6;
}

QComboBox QAbstractItemView {
    background-color: @color02;
    border: 1px solid @borderColor;
    border-radius: 6;
    color: @color05;
    selection-background-color: @accentColor;
    selection-color: @color07;
}

/***************
    QGroupBox
***************/

QGroupBox::title {
    font-size: 11pt;
    font-weight: bold;
    color: @color06;
}

/***************
    QTableView
***************/

QTableView {
    background-color: transparent;
    selection-color: @color05;
    color: @color05;
    font-size: 10pt;
    gridline-color: @borderColor;
    border-radius: 6;
}

QTableView::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

QTableView::item:selected {
    background-color: @color02;
}

#tableProcess::item {
    font-size: 9pt;
}

QHeaderView::section {
    background-color: @color02;
    border-width: 0 0 1 0;
    border-style: solid;
    border-color: @borderColor;
    font-size: 10pt;
    color: @color04;
    padding: @dp8 @dp12;
}

QHeaderView::up-arrow {
    image: url(:/static/themes/common/img/sort-asc.svg);
    width: 10;
    height: 8;
}

QHeaderView::down-arrow {
    image: url(:/static/themes/common/img/sort-dsc.svg);
    width: 10;
    height: 8;
}

/******************
    QMainWindow
*******************/

QMainWindow * {
    font-family: @fontFamily;
}

QLineEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    padding: @dp8;
    background-color: @color02;
    font-size: 10pt;
    color: @color05;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: @accentColor;
}

QPushButton {
    border-radius: @dp6;
    font-size: 10pt;
    padding: @dp8 @dp16;
    min-height: @dp18;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

QPushButton:hover {
    border-color: @accentColor;
    color: @accentColor;
}

QPushButton[accessibleName="danger"] {
    background-color: @destructiveColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="danger"]:hover {
    background-color: @color09;
}

QPushButton[accessibleName="primary"] {
    background-color: @accentColor;
    color: @color07;
    border: 0;
}

QPushButton[accessibleName="primary"]:hover {
    background-color: @accentHover;
}

QLabel[accessibleName="dialog-title"] {
    color: @color05;
    font-size: 12pt;
    font-weight: bold;
    padding-bottom: 8;
    border: 0;
    border-bottom: 1px solid @borderColor;
}

#lblErrorMsg {
    color: @destructiveColor;
}

/**************
    Sidebar
***************/

#sidebar {
    background-color: @sidebar;
    border-right: 1px solid @borderColor;
}

#sidebar QPushButton {
    border: 0;
    height: @dp32;
    border-radius: @dp6;
    color: @color06;
    margin: 1 @dp8;
    padding: 0 @dp12;
    text-align: left;
    font-size: 10pt;
    border-left: 3px solid transparent;
    background-color: @sidebar;
}

#sidebar QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    font-weight: 600;
    border-left: 3px solid @accentColor;
}

#sidebar QPushButton:hover:!checked {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @borderColor;
}

/* Section toggle headers (collapsible groups) */
#sidebar #sectionToggle {
    font-size: 8pt;
    font-weight: 600;
    color: @tertiaryText;
    padding: 12px 12px 4px 20px;
    text-transform: uppercase;
    border: 0;
    border-top: 1px solid @borderColor;
    margin-top: 6px;
    background: transparent;
    text-align: left;
}

#sidebar #sectionToggle:hover {
    color: @color05;
    background-color: transparent;
}

/* Sidebar logo */
#sidebarLogo {
    background: transparent;
    border: 0;
}

/* Sidebar toggle button */
#btnSidebarToggle {
    border: 0;
    border-radius: @dp4;
    background: transparent;
    padding: 0;
}

#btnSidebarToggle:hover {
    background-color: @color02;
}

/* Collapsed sidebar overrides */
#sidebar[collapsed="true"] QPushButton {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 3px solid transparent;
}

#sidebar[collapsed="true"] QPushButton:checked {
    background-color: @accentBgTint;
    color: @accentColor;
    border-left: 0;
    border-bottom: 3px solid @accentColor;
}

#sidebar[collapsed="true"] QPushButton:hover:!checked {
    border-left: 0;
    border-bottom: 3px solid @borderColor;
}

#sidebar[collapsed="true"] #btnSidebarToggle {
    text-align: center;
    padding: 0;
    border-left: 0;
    border-bottom: 0;
}

#sidebar[collapsed="true"] #sectionToggle {
    border-top: 0;
    margin-top: 0;
    padding: 0;
    max-height: 0;
}

#sidebarDividerLine {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 4 12;
}

/* Sidebar scroll area — transparent so sidebar background shows through */
#sidebarScrollArea, #sidebarScrollArea > QWidget, #sidebarNavContainer {
    background: transparent;
    border: 0;
}

/* Thin scrollbar rail, only visible when nav content overflows */
#sidebarScrollArea QScrollBar:vertical {
    background: transparent;
    width: 4px;
    margin: 0;
}
#sidebarScrollArea QScrollBar::handle:vertical {
    background: @color04;
    border-radius: 2px;
    min-height: 20px;
}
#sidebarScrollArea QScrollBar::handle:vertical:hover {
    background: @color05;
}
#sidebarScrollArea QScrollBar::add-line:vertical,
#sidebarScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}

#sidebarVersionLabel {
    color: @tertiaryText;
    font-size: 8pt;
    padding: 0 12;
}

#sidebarBadge {
    background-color: @accentColor;
    color: @color07;
    font-size: 7pt;
    font-weight: 700;
    border-radius: 8;
    padding: 1 6;
    min-width: 16;
    max-height: 16;
}

#sidebarBadgeDot {
    background-color: @accentColor;
    border-radius: 4;
    min-width: 8;
    max-width: 8;
    min-height: 8;
    max-height: 8;
}

#updatesBadge {
    background-color: @updatesColor;
    color: @color07;
    font-size: 7pt;
    font-weight: 700;
    border-radius: 8;
    padding: 1 6;
    min-width: 16;
    max-height: 16;
}

#updatesBadgeDot {
    background-color: @updatesColor;
    border-radius: 4;
    min-width: 8;
    max-width: 8;
    min-height: 8;
    max-height: 8;
}

#sidebarSectionIndicator {
    background-color: @sidebarDivider;
    border: 0;
    max-height: 1;
    margin: 2 16;
}

/********************
    COMMAND PALETTE
*********************/

#commandPaletteInner {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#commandPaletteSearch {
    background-color: @color01;
    color: @color05;
    border: 0;
    border-bottom: 1px solid @borderColor;
    border-radius: 12px 12px 0 0;
    padding: 14 16;
    font-size: 13pt;
}

#commandPaletteSearch:focus {
    border-bottom: 1px solid @accentColor;
}

#commandPaletteResults {
    background-color: transparent;
    border: 0;
    padding: 4 0;
}

#commandPaletteResults::item {
    color: @color06;
    padding: 8 16;
    border: 0;
    font-size: 10pt;
}

#commandPaletteResults::item:selected {
    background-color: @color02;
    color: @color05;
    border-left: 3px solid @accentColor;
}

#commandPaletteResults::item:hover:!selected {
    background-color: @color02;
}

#commandPaletteFooter {
    border-top: 1px solid @borderColor;
    background-color: @color01;
}

#commandPaletteKey {
    font-family: @monoFontFamily;
    font-size: 8pt;
    color: @tertiaryText;
    padding: 1 4;
    border: 1px solid @borderColor;
    border-radius: 4;
    background-color: @color02;
}

#commandPaletteHintLabel {
    font-size: 8pt;
    color: @tertiaryText;
}

#pageContent {
    background-color: @pageContent;
}

/********************
    DASHBOARD PAGE
*********************/

/* - Circle Bar - */

#widgetCircleBar {
    background-color: @cardBg;
    border-radius: 12;
}

#lblCircleChartTitle,
#lblCircleChartValue {
    color: @color05;
    font-size: 13pt;
    margin: 0;
}

/* - Line Bar - */

#lineChartWidget {
    background-color: @cardBg;
    border-radius: 12;
}

#lblLineChartTitle {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartValue {
    color: @color05;
    font-size: 13pt;
}

#lblLineChartTotal {
    color: @color06;
    font-size: 10pt;
}

#lineChartProgress {
    background-color: @color02;
    border: 0;
    border-radius: 3;
    max-height: 6;
}

#lineChartProgress::chunk {
    background-color: @accentColor;
    border-radius: 3;
}

/* - Metric Tile - */

#metricTile, #gaugeTile, #ringTile, #hybridTile, #speedometerTile, #vuMeterTile, #healthScoreTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#metricTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#metricTileInput {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 500;
}

#metricTileValue {
    color: @color05;
    font-size: 14pt;
    font-weight: 700;
}

#metricTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

#metricTileHeader, #metricTileFooter {
    background-color: transparent;
}

#metricTileSource {
    color: @tertiaryText;
    font-size: 8pt;
}

#metricTileAccent {
    background-color: @borderColor;
    border-radius: 1;
}

#metricTileTrend {
    color: @tertiaryText;
    font-size: 8pt;
    padding: 1 6;
    border-radius: 8;
    background-color: @chartGridColor;
}

#metricTileProgress {
    background-color: @chartGridColor;
    border: 0;
    border-radius: 2;
    max-height: 4;
}

#metricTileProgress::chunk {
    border-radius: 2;
}

#metricTileAction {
    font-size: 8pt;
    padding: 2 8;
    border-radius: 10;
    background: transparent;
}

/* - Disk Donut Tile - */

#diskTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#diskTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#diskTileSubtitle {
    color: @tertiaryText;
    font-size: 9pt;
}

#diskHealthStatus {
    font-size: 9pt;
    font-weight: 600;
}

#btnDiskGear {
    border: 0;
    background-color: transparent;
    border-radius: 4;
    padding: 0;
}

#btnDiskGear:hover {
    background-color: @color02;
}

#btnDiskGear::menu-indicator {
    width: 0;
    height: 0;
}

/* - Network Tile - */

#networkTile {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}


#networkTileTitle {
    color: @color06;
    font-size: 9pt;
    font-weight: 600;
}

#networkDivider {
    background-color: @borderColor;
    border: 0;
    max-height: 1;
    margin: 4 0;
}

#networkTileLabel {
    font-size: 9pt;
    font-weight: 600;
}

#networkTileValue {
    color: @color05;
    font-size: 13pt;
    font-weight: 700;
}

#networkTileFooter {
    color: @tertiaryText;
    font-size: 8pt;
}

#networkTileInterface {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - Edit Mode Toolbar - */

#editToolbar {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
}

#editToolbarLabel {
    color: @color05;
    font-size: 10pt;
    font-weight: 600;
}

#btnEditToggle {
    border: 0;
    background-color: transparent;
    border-radius: 6;
    padding: 4;
}

#btnEditToggle:hover {
    background-color: @color02;
}

#btnResetLayout {
    font-size: 9pt;
    padding: 4 12;
    border-radius: 6;
    border: 1px solid @borderColor;
    color: @color05;
    background-color: transparent;
}

#btnResetLayout:hover {
    background-color: @color02;
}

#btnEditDone {
    font-size: 9pt;
    padding: 4 12;
    border-radius: 6;
    border: 1px solid @accentColor;
    color: @color07;
    background-color: @accentColor;
}

#btnEditDone:hover {
    background-color: @accentHover;
}

#dragIndicator {
    background-color: @accentColor;
    border: 2px solid @accentColor;
    border-radius: 12;
}

#dashPlaceholder {
    background-color: transparent;
    border: @dp1 dashed @borderColor;
    border-radius: @dp8;
}

/* - System Summary Card - */

#systemSummaryCard {
    background-color: @cardBg;
    border-radius: 12;
    border: 1px solid @borderColor;
}

#summaryLabel {
    color: @tertiaryText;
    font-size: 8pt;
    font-weight: 600;
}

#summaryValue {
    color: @color05;
    font-size: 10pt;
}

/* - Status Footer - */

#statusFooter {
    background-color: @sidebar;
    border-top: 1px solid @borderColor;
    border-radius: 0;
}

#statusFooter QLabel {
    color: @tertiaryText;
    font-size: 8pt;
}

/* - Temperature Gauge - */

#tempContainer {
    background-color: @cardBg;
    border-radius: 12;
}

#btnMetricGear {
    border: 0;
    background-color: transparent;
    border-radius: 4;
    padding: 0;
}

#btnMetricGear:hover {
    background-color: @color02;
}

#btnMetricGear::menu-indicator {
    width: 0;
    height: 0;
}

/* - Kiosk Toggle Button - */

#btnKioskToggle {
    border: 0;
    background-color: transparent;
    border-radius: @dp4;
}

#btnKioskToggle:hover {
    background-color: @color02;
}


/**************************
    HARDWARE INFO PAGE
***************************/

#HardwareInfoPage {
    background-color: transparent;
}

#HardwareInfoPage #scrollArea,
#HardwareInfoPage #scrollContent {
    background-color: transparent;
}

#HardwareInfoPage QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    background-color: @cardBg;
}

#HardwareInfoPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

#HardwareInfoPage QTableWidget {
    background-color: transparent;
    border: 0;
}

#HardwareInfoPage QTableWidget::item {
    font-size: 10pt;
    color: @color05;
    padding: @dp8 @dp6;
    background-color: @color01;
}

/**************************
    SYSTEM CLEANER PAGE
***************************/

#lblCleanerTitle {
    color: @color11;
    font-size: 11pt;
    font-weight: 700;
}

#lblCleanerSubtitle {
    font-size: 9pt;
    color: @color06;
    padding-bottom: 4;
}

/* - Category cards - */

#cleanerCategoryCard {
    background-color: @cardBgElevated;
    border: 1px solid @borderColor;
    border-radius: 8;
}

#cleanerCategoryCard[checked="true"] {
    border: 2px solid @accentColor;
}

#cleanerCategoryCard #lblCatName {
    font-size: 10pt;
    font-weight: 600;
    color: @color05;
}

#cleanerCategoryCard #lblCatSubtitle {
    font-size: 8pt;
    color: @color06;
    font-family: @monoFontFamily;
}

#cleanerCategoryCard #lblCatSize {
    font-size: 9pt;
    color: @color06;
}

/* - Scan progress bar - */

#cleanerScanProgress {
    background-color: @borderColor;
    border: none;
    border-radius: 2;
}

#cleanerScanProgress::chunk {
    background-color: @accentColor;
    border-radius: 2;
}

/* - Header action buttons - */

#btnScheduleCleaner {
    border: 1px solid @borderColor;
    border-radius: @dp6;
    background-color: transparent;
    color: @color05;
    padding: @dp6 @dp14;
}

#btnScheduleCleaner:hover {
    background-color: @cardBg;
}

#btnScanSystem {
    border: 0;
    border-radius: @dp6;
    background-color: @accentColor;
    color: @color07;
    font-weight: 700;
    padding: @dp6 @dp16;
}

#btnScanSystem:hover {
    background-color: @accentHover;
}

/* - Footer bar - */

#cleanerFooter {
    background-color: @cardBgElevated;
    border: 1px solid @borderColor;
    border-radius: 8;
}

#lblEstimatedLabel {
    font-size: 7pt;
    color: @color06;
}

#lblEstimatedSize {
    font-size: 13pt;
    font-weight: 700;
    color: @successColor;
}

#btnCleanSelected {
    border: 0;
    border-radius: @dp6;
    background-color: @destructiveColor;
    color: @color07;
    font-weight: 700;
    padding: @dp6 @dp16;
}

#btnCleanSelected:disabled {
    background-color: @color14;
    color: @color06;
}

#btnViewResults {
    border: 0;
    background: transparent;
    color: @accentColor;
    font-size: 9pt;
}

#btnViewResults:hover {
    color: @accentHover;
}

/* - System Clean Button (page 1 tree results) - */

#SystemCleanerPage #btnClean {
    border: 0;
    background: url(:/static/themes/@themeName/img/clean.png) no-repeat center;
}

#SystemCleanerPage #btnClean:hover {
    background: url(:/static/themes/@themeName/img/clean-active.png) no-repeat center;
}

/* - System Scan Results - */

#btnBackToCategories {
    border: 0;
    font-size: 11pt;
    color: @accentColor;
    background-color: @accentBgTint;
}

#lblSortBy {
    font-size: 9pt;
    color: @color06;
}

#cbSortBy {
    font-size: 9pt;
    min-width: 0;
}

#treeWidgetScanResult {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-family: @fontFamily;
}

#treeWidgetScanResult QHeaderView::section {
    border-top: 1;
    font-size: 9pt;
}

#treeWidgetScanResult::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    color: @color11;
}

#treeWidgetScanResult::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetScanResult::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetScanResult::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetScanResult::branch:has-children:!has-siblings:closed,
#treeWidgetScanResult::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch:open:has-children:!has-siblings,
#treeWidgetScanResult::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetScanResult::branch {
    border-bottom: 1px solid @borderColor;
}

#lblRemovedTotalSize {
    font-size: 11pt;
    color: @successColor;
}

#lblTotalBytes {
    font-size: 11pt;
    color: @color05;
}

/* - Schedule Indicator - */

#scheduleIndicator {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
    padding: 8;
}

#lblNextSchedule {
    font-size: 10pt;
    color: @color05;
}

#lblLastSchedule {
    font-size: 9pt;
    color: @color06;
}

#lblSnapshotToast {
    color: @successColor;
    border-left: 3px solid @successColor;
    padding: 4px 10px;
    font-size: 9pt;
}

#lblExclusionNotice {
    color: @color05;
    padding: 6px 0;
}

/************************
    STARTUP APPS PAGE
*************************/
#listWidgetStartup {
    background-color: transparent;
}

#lblStartupAppsTitle {
    color: @color11;
    padding: 10 0 10 12;
}

/************************
    BOOT ANALYSIS PAGE
*************************/
#lblBootAnalysisTitle {
    color: @color11;
    padding: 10 0 4 0;
}

#lblBootAnalysisSubtitle {
    color: @color11;
    padding: 0 0 4 0;
}

#lblBootEmptyState {
    color: @color04;
    font-size: 11pt;
    qproperty-alignment: AlignCenter;
}

/* - Startup App - */

#widgetStartupApp {
    border-radius: 12;
    background-color: @cardBg;
    border: 1px solid transparent;
}

#lblStartupAppIcon {
    image: url(:/static/themes/@themeName/img/app.png);
}

#widgetStartupApp:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#widgetStartupApp #lblStartupAppName {
    font-size: 10pt;
    color: @color05;
}

#checkStartup {
    margin-top: 3;
}

#widgetStartupApp #btnDeleteStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/trash.png);
    border: 0;
}

#widgetStartupApp #btnEditStartupApp {
    qproperty-icon: url(:/static/themes/@themeName/img/edit.png);
    border: 0;
    margin-bottom: 2;
}

#startupSectionHeader {
    color: @tertiaryText;
    font-size: 9pt;
    font-weight: 600;
    padding: @dp4 @dp8;
    background-color: transparent;
}

#widgetStartupApp #lblStartupAppPath {
    color: @tertiaryText;
    font-size: 9pt;
    font-family: @monoFontFamily;
}

/* - BTM (Background Task Management) rows — SSO-3738 - */

#widgetBtmRow {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#widgetBtmRow #lblBtmRowName {
    color: @color05;
    font-size: 10pt;
    font-weight: 600;
}

#widgetBtmRow #lblBtmRowSubtext {
    color: @tertiaryText;
    font-size: 9pt;
    font-family: @monoFontFamily;
}

#widgetBtmRow QLabel[badge="true"] {
    padding: @dp2 @dp6;
    border-radius: @dp4;
    font-size: 9pt;
    font-weight: 600;
    background-color: @cardBgElevated;
    color: @tertiaryText;
}

#widgetBtmRow #btmBadgeOn {
    background-color: @successColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeOff {
    background-color: @cardBgElevated;
    color: @tertiaryText;
}

#widgetBtmRow #btmBadgeOrphan {
    background-color: @destructiveColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeDuplicate {
    background-color: @warningColor;
    color: @overlayText;
}

#widgetBtmRow #btmBadgeApple {
    background-color: @infoColor;
    color: @overlayText;
}

#btnRepairBtm {
    background-color: @destructiveColor;
    color: @overlayText;
    border-radius: @dp4;
    padding: @dp6 @dp10;
    font-weight: 600;
}

#btnRepairBtm:hover {
    background-color: @accentHover;
}

/* - Startup App Edit - */

#StartupAppEdit {
    background-color: @pageContent;
}

/**************************
    SERVICES PAGE
***************************/

#ServicesPage QListWidget {
    background-color: transparent;
}

#lblServicesTitle {
    font-size: 11pt;
    color: @color11;
    padding: 10 0;
}

/* - Service Item - */

#serviceItemWidget {
    border-radius: 12;
    background-color: @cardBg;
    border: 1px solid transparent;
}

#serviceItemWidget:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}


#ServiceItem #lblServiceName {
    font-size: 10pt;
    color: @color05;
    font-family: @monoFontFamily;
}

#ServiceItem #lblServiceDescription {
    font-size: 9pt;
    color: @color06;
    font-family: @monoFontFamily;
}

#ServiceItem #checkServiceRunning {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 600;
    min-width: 60px;
    max-width: 80px;
    spacing: 0px;
}

#ServiceItem #checkServiceRunning::indicator {
    width: 0px;
    height: 0px;
}

#ServiceItem #checkServiceRunning:checked {
    background-color: @successColor;
    color: @color07;
}

#ServiceItem #checkServiceRunning:!checked {
    background-color: @color02;
    color: @color04;
    border: 1px solid @borderColor;
}

#lblServiceStartupImg {
    image: url(:/static/themes/@themeName/img/power.svg);
}

#lblSystemRunningImg {
    image: url(:/static/themes/@themeName/img/run.svg);
}

/**********************
    PROCESSES PAGE
***********************/

#lblProcessTitle {
    color: @color11;
    padding: 10 0;
    font-size: 11pt;
}

#checkAllProcesses {
    margin-top: 2;
    color: @color12;
    font-size: 10pt;
}

#checkAllProcesses::indicator {
    width: @dp14;
    height: @dp14;
}

#txtProcessSearch {
    width: @dp180;
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

#lblRefresh {
    color: @color12;
    font-size: 10pt;
}

#sliderRefresh {
    margin-top: 3;
}

/************************
    UNINSTALLER PAGE
*************************/

#nav QPushButton {
    border-radius: @dp6;
    padding: @dp6 @dp12;
    font-size: 10pt;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

#nav QPushButton:hover,
#nav QPushButton:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

/**************************
    HELPERS PAGE
***************************/
#lblToolsSection, #lblMaintenanceSectionHeader {
    font-size: 8pt;
    font-weight: 600;
    color: @color04;
}

#maintenanceCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8;
    padding: 8 12;
}

#maintenanceCard:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#maintenanceCard #lblCardTitle {
    font-size: 10pt;
    font-weight: 600;
}

#maintenanceCard #lblCardDesc {
    font-size: 8pt;
    color: @color06;
}

/* - Search field (shared: Uninstaller / APT Source Manager / Homebrew) - */
#txtPackageSearch,
#txtSearchAptSource {
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

/* -- Package tree (Uninstaller + Homebrew) -- table style matching System Cleaner -- */

#treeWidgetPackages {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetPackages QHeaderView::section {
    border-top: 1;
}

#treeWidgetPackages::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetPackages::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetPackages::branch:has-children:!has-siblings:closed,
#treeWidgetPackages::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch:open:has-children:!has-siblings,
#treeWidgetPackages::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetPackages::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Available Updates tree (FR-60) -- matching treeWidgetPackages -- */

#treeWidgetUpdates {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetUpdates QHeaderView::section {
    border-top: 1;
}

#treeWidgetUpdates::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

/* -- Snap package list (card style, unchanged) -- */

#listWidgetSnapPackages {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#listWidgetSnapPackages::indicator {
    width: @dp16;
    height: @dp16;
}

#listWidgetSnapPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#listWidgetSnapPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#listWidgetSnapPackages::item {
    border-radius: @dp8;
    min-height: @dp36;
    background-color: @cardBg;
    margin: 1 0;
}

#listWidgetSnapPackages::item:text {
    color: @color05;
    padding-left: @dp12;
}

#listWidgetSnapPackages::item:selected {
    background-color: @color02;
    border: 0;
}

#listWidgetSnapPackages::item:hover {
    background-color: @color02;
}

/* -- Orphan package list (matching snap package style) -- */

#listWidgetOrphanPackages {
    border: 0;
    background-color: transparent;
    font-size: 10pt;
}

#listWidgetOrphanPackages::indicator {
    width: @dp16;
    height: @dp16;
}

#listWidgetOrphanPackages::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#listWidgetOrphanPackages::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#listWidgetOrphanPackages::item {
    border-radius: @dp8;
    min-height: @dp36;
    background-color: @cardBg;
    margin: 1 0;
}

#listWidgetOrphanPackages::item:text {
    color: @color05;
    padding-left: @dp12;
}

#listWidgetOrphanPackages::item:selected {
    background-color: @color02;
    border: 0;
}

#listWidgetOrphanPackages::item:hover {
    background-color: @color02;
}

/**************************
    DISK TOOLS PAGE
***************************/

/* Directory picker lists */

#diskToolsDirList {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
    color: @color05;
}

#diskToolsDirList::item {
    padding: @dp4 @dp6;
    color: @color05;
}

#diskToolsDirList::item:selected {
    background-color: @color02;
}

/* Large & Old results tree */

#treeWidgetLargeOld {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetLargeOld QHeaderView::section {
    border-top: 1;
}

#treeWidgetLargeOld::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetLargeOld::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetLargeOld::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetLargeOld::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

/* Duplicate Finder results tree */

#treeWidgetDuplicates {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetDuplicates QHeaderView::section {
    border-top: 1;
}

#treeWidgetDuplicates::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetDuplicates::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetDuplicates::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetDuplicates::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetDuplicates::branch:has-children:!has-siblings:closed,
#treeWidgetDuplicates::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetDuplicates::branch:open:has-children:!has-siblings,
#treeWidgetDuplicates::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetDuplicates::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Docker tree widgets (Images / Containers / Volumes) -- */

#treeWidgetImages,
#treeWidgetContainers,
#treeWidgetVolumes {
    border: 1px solid @borderColor;
    background-color: transparent;
    border-radius: 8;
    font-size: 10pt;
}

#treeWidgetImages QHeaderView::section,
#treeWidgetContainers QHeaderView::section,
#treeWidgetVolumes QHeaderView::section {
    border-top: 1;
}

#treeWidgetImages::item,
#treeWidgetContainers::item,
#treeWidgetVolumes::item {
    border-bottom: 1px solid @borderColor;
    padding: @dp8 @dp6;
    font-size: 10pt;
    color: @color11;
}

#treeWidgetImages::indicator,
#treeWidgetContainers::indicator,
#treeWidgetVolumes::indicator {
    width: @dp14;
    height: @dp14;
}

#treeWidgetImages::indicator:unchecked,
#treeWidgetContainers::indicator:unchecked,
#treeWidgetVolumes::indicator:unchecked {
    image: url(:/static/themes/common/img/un-check.png);
}

#treeWidgetImages::indicator:checked,
#treeWidgetContainers::indicator:checked,
#treeWidgetVolumes::indicator:checked {
    image: url(:/static/themes/common/img/check.png);
}

#treeWidgetImages::branch:has-children:!has-siblings:closed,
#treeWidgetImages::branch:closed:has-children:has-siblings,
#treeWidgetContainers::branch:has-children:!has-siblings:closed,
#treeWidgetContainers::branch:closed:has-children:has-siblings,
#treeWidgetVolumes::branch:has-children:!has-siblings:closed,
#treeWidgetVolumes::branch:closed:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-right.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetImages::branch:open:has-children:!has-siblings,
#treeWidgetImages::branch:open:has-children:has-siblings,
#treeWidgetContainers::branch:open:has-children:!has-siblings,
#treeWidgetContainers::branch:open:has-children:has-siblings,
#treeWidgetVolumes::branch:open:has-children:!has-siblings,
#treeWidgetVolumes::branch:open:has-children:has-siblings {
    image: url(:/static/themes/common/img/chevron-down.svg);
    border-image: none;
    padding: 4;
}

#treeWidgetImages::branch,
#treeWidgetContainers::branch,
#treeWidgetVolumes::branch {
    border-bottom: 1px solid @borderColor;
}

/* -- Helper Widgets (Firewall / Open Ports / Network Diagnostics) -- */

/* Firewall Widget */

#fwStatusDot {
    font-size: 16px;
}

#fwTitle {
    color: @color05;
    font-size: 16px;
    font-weight: bold;
}

#fwStatusText {
    color: @color05;
    font-size: 14px;
    font-weight: bold;
}

#fwToggle {
    background-color: @accentColor;
    color: @color07;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

#fwToggle:hover {
    opacity: 0.9;
}

#fwToggle:disabled {
    background-color: @cardBg;
    color: @color04;
}

#fwDetailCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8px;
}

#fwDetailCard QLabel {
    color: @color04;
    font-size: 12px;
}

#fwWarning {
    color: @warningColor;
    font-size: 13px;
}

#fwHelpBtn {
    color: @color04;
    font-size: 14px;
    font-weight: bold;
    border: 1px solid @color04;
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

#fwRefresh {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

#fwRefresh:hover {
    border-color: @accentColor;
}

#fwRefresh:disabled {
    color: @color04;
}

/* Open Ports Widget */

#portsTitle {
    color: @color05;
    font-size: 16px;
    font-weight: bold;
}

#portsSearch {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

#portsSearch:focus {
    border-color: @accentColor;
}

#portsListenToggle {
    background-color: @cardBg;
    color: @color04;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

#portsListenToggle:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#portsListenToggle:hover:!checked {
    border-color: @accentColor;
}

#portsRefresh {
    background-color: @accentColor;
    color: @color07;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

#portsRefresh:hover {
    opacity: 0.9;
}

#portsRefresh:disabled {
    background-color: @cardBg;
    color: @color04;
}

#portsTable {
    background-color: @cardBg;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: 6px;
    gridline-color: @borderColor;
    font-size: 12px;
}

#portsTable::item {
    padding: 4px 8px;
}

#portsTable::item:selected {
    background-color: @accentColor;
    color: @color07;
}

#portsTable QHeaderView::section {
    background-color: @cardBg;
    color: @color04;
    border: none;
    border-bottom: 1px solid @borderColor;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
}

#portsSecondary {
    color: @color04;
    font-size: 12px;
}

/* Network Diagnostics Widget */

#netDiagTitle {
    color: @color05;
    font-size: 16px;
    font-weight: bold;
}

#netDiagCard {
    background-color: @cardBg;
    border: 1px solid @borderColor;
    border-radius: 8px;
}

#netDiagSubheader {
    color: @color05;
    font-size: 14px;
    font-weight: bold;
}

#netDiagSecondary {
    color: @color04;
    font-size: 12px;
}

#netDiagLoading {
    color: @color04;
    font-size: 13px;
}

#netDiagRetest {
    background-color: @accentColor;
    color: @color07;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}

#netDiagRetest:hover {
    opacity: 0.9;
}

#netDiagRetest:disabled {
    background-color: @cardBg;
    color: @color04;
}

#netDiagCheckIcon {
    font-weight: bold;
    font-size: 14px;
}

#netDiagCheckIcon[checkPassed="true"] {
    color: @successColor;
}

#netDiagCheckIcon[checkPassed="false"] {
    color: @destructiveColor;
}

#netDiagCheckLabel {
    color: @color05;
    font-size: 13px;
}

#netDiagCheckValue {
    font-size: 13px;
}

#netDiagCheckValue[checkPassed="true"] {
    color: @color04;
}

#netDiagCheckValue[checkPassed="false"] {
    color: @destructiveColor;
}

#netDiagDnsServer {
    color: @color05;
    font-size: 13px;
}

/* Power Profile Widget (Helpers page, Linux only) */

#powerProfileWidget {
    background-color: @cardBg;
    border-radius: 6px;
}

#powerProfileLabel {
    color: @color05;
    font-size: 12px;
}

#powerProfileWidget QPushButton {
    background-color: @cardBg;
    color: @color04;
    border: 1px solid @borderColor;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

#powerProfileWidget QPushButton:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

#powerProfileWidget QPushButton:hover:!checked {
    border-color: @accentColor;
}

#verifyDiskStatus {
    font-weight: bold;
}

#powerProfileWarning {
    color: @warningColor;
    font-size: 11px;
    padding: 2px 0;
}

/* Action bar and buttons */

#DiskToolsPage #actionBarFrame {
    background-color: @color01;
    border: 1px solid @borderColor;
    border-radius: 6;
}

#DiskToolsPage #btnScan {
    border: 0;
    border-radius: @dp6;
    background-color: @accentColor;
    color: @color07;
    font-size: 10pt;
    font-weight: bold;
    padding: @dp8 @dp24;
}

#DiskToolsPage #btnScan:hover {
    background-color: @accentHover;
}

#DiskToolsPage #btnTrash {
    border: 0;
    border-radius: @dp6;
    background-color: @destructiveColor;
    color: @color07;
    font-size: 10pt;
    font-weight: bold;
    padding: @dp8 @dp16;
}

#DiskToolsPage #btnTrash:hover {
    background-color: @color09;
}

#DiskToolsPage #btnTrash:disabled {
    background-color: @borderColor;
    color: @color04;
}

#DiskToolsPage #lblStatus {
    font-size: 10pt;
    color: @color06;
}

/****************
    HISTORIES
*****************/
/* NEX Phase-2 "Resources" page selectors (history chart bands) live here. */

#charts {
    background-color: @pageContent;
}

#lblHistoryTitle {
    font-size: 11pt;
    margin: 6 0 10 0;
    color: @color12;
}

#checkHistoryTitle::indicator {
    width: @dp16;
    height: @dp16;
}

#checkHistoryTitle::indicator:unchecked {
    image: url(:/static/themes/@themeName/img/fit.png);
}

#checkHistoryTitle::indicator:checked {
    image: url(:/static/themes/@themeName/img/collapse.png);
}

/***************
    SETTINGS
****************/

#SettingsPage #scrollArea,
#SettingsPage #scrollContent {
    background-color: transparent;
}

#SettingsPage QGroupBox {
    border: none;
    border-radius: 0;
    margin-top: 24;
    padding: 8 0 0 0;
    background-color: transparent;
}

#SettingsPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

#SettingsPage QLabel {
    font-size: 10pt;
    color: @color12;
}

#lblCreatedBy {
    font-size: 9pt;
    color: @color06;
}

#lblQuickSetupSummary {
    font-size: 9pt;
    color: @color06;
}

/* - Shared dialog label styles - */

QLabel[accessibleName="dimmed"] {
    color: @color06;
}

QLabel[accessibleName="dimmed-small"] {
    font-size: 9pt;
    color: @color06;
}

/* - Status property selectors (semi-dynamic: set via setProperty("status", ...)) - */

[status="success"] { color: @successColor; }
[status="warning"] { color: @warningColor; }
[status="error"]   { color: @destructiveColor; }
[status="info"]    { color: @color05; }
[status="dimmed"]  { color: @color04; }
[status="neutral"] { color: @tertiaryText; }

#wizardStepIcon {
    font-weight: bold;
}

#wizardStepIcon[status="success"] { font-size: 16px; }
#wizardStepIcon[status="warning"] { font-size: 14px; font-weight: normal; }
#wizardStepIcon[status="info"]    { font-size: 14px; }
#wizardStepIcon[status="error"]   { font-size: 16px; }

#lblTrashWarning {
    font-size: 9pt;
    color: @warningColor;
}

/*****************
    UPDATE BAR
******************/

#widgetUpdateBar {
    background-color: @accentColor;
    border-radius: 6;
}

#lblUpdateBarText {
    font-size: 10pt;
    color: @color07;
}

#btnDownloadUpdate {
    background-color: @color01;
    color: @color05;
    padding: @dp2 @dp10;
    border-radius: @dp4;
    font-size: 9pt;
    max-height: @dp22px;
}

/****************
    FEEDBACK
*****************/

#Feedback {
    background-color: @pageContent;
}

/**************************
    APT SOURCE MANAGER PAGE
***************************/
#listWidgetAptSources {
    background-color: transparent;
}

#lblAptSourceTitle {
    color: @color11;
    padding: 10 0 5 12;
}

/* - Homebrew: "Available Updates (N)" title (mLblUpdatesTitle) - */
#lblUpdatesTitle {
    color: @color11;
    padding: 10 0 5 12;
}

#txtAptSource {
    padding: 8;
}

#lblAptSourceSelectInfo {
    margin-top: 5;
    font-size: 10pt;
    color: @color05;
}

#listWidgetAptSources {
    selection-background-color: @accentColor;
}

/* - APT Source Repository Item - */

#aptSourceRepositoryItemWidget {
    border-radius: 12;
    background-color: @cardBg;
    border: 1px solid transparent;
}

#lblAptSourceIcon {
    image: url(:/static/themes/@themeName/img/ppa-repository.png);
}

#aptSourceRepositoryItemWidget:hover {
    background-color: @cardBgElevated;
    border-color: @accentColor;
}

#lblAptSourceName {
    font-size: 10pt;
    color: @color05;
    font-family: @monoFontFamily;
}

#lblRepoDescription {
    color: @tertiaryText;
}

#repoStatusDot {
    font-size: 10px;
    font-weight: bold;
}

#aptSourceRepositoryItemWidget[repoStatus="success"] { border-left: 3px solid @successColor; }
#aptSourceRepositoryItemWidget[repoStatus="warning"] { border-left: 3px solid @warningColor; }
#aptSourceRepositoryItemWidget[repoStatus="error"]   { border-left: 3px solid @destructiveColor; }
#aptSourceRepositoryItemWidget[repoStatus="neutral"] { border-left: 3px solid @tertiaryText; }

#checkAptSource {
    margin-top: 3;
}

/* - Repo Detail Panel - */

#repoDetailPanel {
    background-color: @pageContent;
    border-left: 1px solid @borderColor;
}

#repoDetailName {
    color: @color05;
}

#repoDetailDescription {
    color: @color04;
}

#repoDetailMetadata {
    background-color: transparent;
}

#repoMetaLabel {
    font-size: 9px;
    color: @tertiaryText;
    background-color: transparent;
}

#repoMetaValue {
    color: @color05;
    background-color: transparent;
}

#repoStatusBadge {
    color: @color07;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}

#repoStatusBadge[repoStatus="healthy"] { background-color: @successColor; }
#repoStatusBadge[repoStatus="warning"] { background-color: @warningColor; }
#repoStatusBadge[repoStatus="error"]   { background-color: @destructiveColor; }
#repoStatusBadge[repoStatus="unknown"] { background-color: @tertiaryText; }

#repoMetaValue[repoStatus="healthy"] { color: @successColor; }
#repoMetaValue[repoStatus="warning"] { color: @warningColor; }
#repoMetaValue[repoStatus="error"]   { color: @destructiveColor; }
#repoMetaValue[repoStatus="unknown"] { color: @tertiaryText; }

#repoIssueCard {
    background-color: @cardBg;
    border-radius: 4px;
}

#repoIssueCard[issueSeverity="error"]   { border-left: 3px solid @destructiveColor; }
#repoIssueCard[issueSeverity="warning"] { border-left: 3px solid @warningColor; }
#repoIssueCard[issueSeverity="info"]    { border-left: 3px solid @tertiaryText; }

#repoIssueCard QPushButton[accessibleName="primary"] {
    background-color: @accentColor;
    color: @color07;
    border: 0;
    border-radius: @dp4;
    padding: @dp2 @dp10;
}

#repoIssueCard QPushButton[accessibleName="primary"]:hover {
    background-color: @accentHover;
}

#repoRemoveBtn {
    color: @destructiveColor;
    background-color: transparent;
    border: 1px solid @destructiveColor;
    border-radius: @dp4;
    padding: @dp2 @dp10;
}

#repoIssueSummary { font-weight: bold; }
#repoIssueSummary[issueSeverity="error"]   { color: @destructiveColor; }
#repoIssueSummary[issueSeverity="warning"] { color: @warningColor; }
#repoIssueSummary[issueSeverity="info"]    { color: @tertiaryText; }

#repoIssueDetail {
    color: @tertiaryText;
}

#repoDiagIcon { font-weight: bold; }
#repoDiagIcon[diagStatus="ok"]      { color: @successColor; }
#repoDiagIcon[diagStatus="warning"] { color: @warningColor; }
#repoDiagIcon[diagStatus="failed"]  { color: @destructiveColor; }

#repoSuggestion {
    color: @warningColor;
    font-style: italic;
}

#repoDiagnoseStep {
    color: @color05;
    background-color: transparent;
}

/* - APT Source Repository Item Edit - */

#APTSourceEdit {
    background-color: @pageContent;
}

/**************************
    GNOME SETTINGS PAGE
***************************/

#GnomeSettingsPage QLabel {
    font-size: 10pt;
    color: @color12;
}

#GnomeSettingsPage QGroupBox {
    border: 1px solid @borderColor;
    border-radius: 12;
    margin-top: 12;
    padding: 12 12 6 12;
    background-color: @cardBg;
}

#GnomeSettingsPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6;
    color: @color05;
    font-size: 11pt;
    font-weight: bold;
}

/* Tab nav buttons */
#GnomeSettingsPage QPushButton[accessibleName="navBtn"] {
    border-radius: @dp6;
    padding: @dp6 @dp12;
    font-size: 10pt;
    background-color: @color01;
    color: @color05;
    border: 1px solid @borderColor;
}

#GnomeSettingsPage QPushButton[accessibleName="navBtn"]:hover,
#GnomeSettingsPage QPushButton[accessibleName="navBtn"]:checked {
    background-color: @accentColor;
    color: @color07;
    border-color: @accentColor;
}

/* Browse buttons */
#btnBrowseWallpaper,
#btnBrowseWallpaperDark {
    background-color: @color01;
    padding: @dp6 @dp12;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#btnBrowseWallpaper:hover,
#btnBrowseWallpaperDark:hover {
    border-color: @color04;
}

/* Speed value labels */
#GnomeSettingsPage #lblMouseSpeedVal,
#GnomeSettingsPage #lblTouchpadSpeedVal {
    color: @color05;
    font-weight: bold;
}

/* Inline error status label */
#GnomeSettingsPage #lblStatus {
    color: @destructiveColor;
    background-color: @cardBg;
    border: 1px solid @destructiveColor;
    border-radius: 6;
    padding: 6 12;
    font-size: 9pt;
}

/*******************************
SEARCH
*******************************/
#txtSearchInput {
    padding: @dp6 @dp12;
    border-radius: @dp6;
    background-color: @color01;
    border: 1px solid @borderColor;
    color: @color05;
}

#btnSearchAdvance {
    padding: @dp6 @dp12;
    background-color: @accentColor;
    color: @color07;
    border-radius: @dp6;
}

#lblFoundFilesInfo {
    color: @successColor;
}

#lblSearchDir {
    font-size: 10pt;
    color: @color06;
}

#btnBrowseSearchDir {
    background-color: @color01;
    padding: @dp6 @dp12;
    color: @color05;
    border: 1px solid @borderColor;
    border-radius: @dp6;
}

#advanceSearchPane QSpinBox {
    padding: @dp4 @dp6;
}

#advanceSearchPane QCheckBox[accessibleName="circle"]::indicator {
    width: @dp15px;
    height: @dp15px;
}

#advanceSearchPane QLabel {
    color: @color06;
}

#advanceSearchPane QLineEdit {
    padding: @dp4 @dp6;
}

#btnAdvancePaneToggle,
#btnNewHost {
    font-size: 10pt;
    color: @accentColor;
    border: 0;
    background-color: @accentBgTint;
}

#lblHostTitle {
    font-size: 11pt;
    color: @color12;
}

/* === Network Usage ===
   Reserved — no selectors yet. NEX Phase-2 "Network Usage" page item adds
   its #netUsage* selectors here (see network_usage_page.cpp setObjectName
   calls). */

/* === System Logs ===
   Reserved — no selectors yet. NEX Phase-2 "System Logs" page item adds
   its #*Log* / #cmbLogSeverity selectors here (see system_logs_page.cpp
   setObjectName calls). */

/***************************************
    Keyboard focus ring (SSO-3502)
    Token-driven visible focus indicator
    for interactive controls. Applied
    under both default and light themes
    via the @focusRingColor token.
****************************************/

QPushButton:focus,
QToolButton:focus,
QComboBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid @focusRingColor;
}

QCheckBox:focus,
QRadioButton:focus,
QSlider:focus {
    outline: 2px solid @focusRingColor;
}

QTreeView:focus,
QTreeWidget:focus,
QTableView:focus,
QTableWidget:focus,
QListView:focus,
QListWidget:focus {
    border: 2px solid @focusRingColor;
}

QTreeView::item:focus,
QTreeWidget::item:focus,
QTableView::item:focus,
QTableWidget::item:focus,
QListView::item:focus,
QListWidget::item:focus {
    outline: 2px solid @focusRingColor;
}

#sidebar QPushButton:focus {
    border-left: 3px solid @focusRingColor;
}

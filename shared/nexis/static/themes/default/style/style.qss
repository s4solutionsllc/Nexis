}

#portsTable::item {
    padding: 4px 8px;
}

#portsTable::item:selected {
    background-color: @accentColor;
    color: @color07;
}

#portsTable QHeaderView::section {
    background-color: @cardBg;
    color: @color04;
    border: none;
    border-bottom: 1px solid @borderColor;
    padding: 6px 8px;
    font-size: 12px;

---
const repoLinks = [
  { href: 'https://github.com/lsimpsonsfdc/Nexis', label: 'GitHub' },
  { href: 'https://github.com/lsimpsonsfdc/Nexis/releases', label: 'Releases' },
  { href: 'https://github.com/lsimpsonsfdc/Nexis/issues', label: 'Issues' },
  { href: 'https://github.com/lsimpsonsfdc/Nexis/blob/native/CHANGELOG.md', label: 'Changelog' },
  { href: 'https://crowdin.com/project/nexis', label: 'Translations' },
];
---

<footer class="border-t border-nexis-border/50 bg-nexis-dark">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Branding -->
      <div>
        <div class="flex items-center gap-3">
          <img src="/Nexis/images/logo.svg" alt="Nexis" class="h-8 w-8" />
          <span class="text-lg font-bold text-nexis-light">Nexis</span>
        </div>
        <p class="mt-3 text-sm text-nexis-muted">
          Open-source system optimizer and monitor for Linux and macOS.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-nexis-muted">Project</h3>
        <ul class="space-y-2">
          {repoLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-nexis-muted transition-colors hover:text-nexis-orange" target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Built with -->
      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-nexis-muted">Built with</h3>
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full border border-nexis-border bg-nexis-dark-card px-3 py-1 text-xs text-nexis-muted">Qt 6</span>
          <span class="rounded-full border border-nexis-border bg-nexis-dark-card px-3 py-1 text-xs text-nexis-muted">C++17</span>
          <span class="rounded-full border border-nexis-border bg-nexis-dark-card px-3 py-1 text-xs text-nexis-muted">GPL v3</span>
        </div>
        <p class="mt-4 text-xs text-nexis-muted">
          Co-authored by <a href="https://claude.ai/claude-code" class="text-nexis-orange hover:underline" target="_blank" rel="noopener noreferrer">Claude Code</a>
        </p>
      </div>
    </div>

    <div class="mt-10 border-t border-nexis-border/50 pt-6 text-center text-xs text-nexis-muted">
      <p>Originally derived from <a href="https://github.com/oguzhaninan/Stacer" class="hover:text-nexis-orange hover:underline" target="_blank" rel="noopener noreferrer">Stacer</a> by oguzhaninan. Licensed under GPL v3.</p>
    </div>
  </div>
</footer>

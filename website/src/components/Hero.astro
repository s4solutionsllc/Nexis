---
let version = "Latest";
try {
  const res = await fetch("https://api.github.com/repos/s4solutionsllc/Nexis/releases/latest", {
    headers: { "Accept": "application/vnd.github.v3+json" },
  });
  if (res.ok) {
    const data = await res.json();
    version = data.tag_name ?? "Latest";
  }
} catch {
  // API unavailable (rate-limited, offline) — fall back to generic label
}
---

<section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
  <!-- Gradient glow -->
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-nexis-orange/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-4xl px-6 text-center">
    <img src="/Nexis/images/logo.svg" alt="Nexis logo" class="mx-auto mb-6 h-20 w-20" />

    <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl lg:text-6xl">
      Free Linux & macOS<br />
      <span class="text-nexis-orange">System Optimizer</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-nexis-muted md:text-xl">
      Monitor hardware, clean system junk, manage services — all in one app.
      The open-source Stacer alternative, built with Qt 6.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="https://github.com/s4solutionsllc/Nexis/releases/latest"
        class="inline-flex items-center gap-2 rounded-lg bg-nexis-orange px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-nexis-orange-hover"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        Download {version}
      </a>
      <button
        id="release-notes-btn"
        class="inline-flex items-center gap-2 rounded-lg border border-nexis-border px-6 py-3 text-sm font-semibold text-nexis-light transition-colors hover:border-nexis-muted hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        Release Notes
      </button>
      <script>
        document.getElementById("release-notes-btn")?.addEventListener("click", () => {
          (document.getElementById("release-notes-modal") as HTMLDialogElement)?.showModal();
        });
      </script>
    </div>
  </div>

  <!-- Hero image -->
  <div class="relative mx-auto mt-16 max-w-5xl px-6">
    <div class="overflow-hidden rounded-xl border border-nexis-border/50 shadow-2xl shadow-nexis-orange/5">
      <img
        src="/Nexis/images/screenshots/dashboard.png"
        alt="Nexis dashboard showing real-time CPU, memory, disk, GPU, and network monitoring"
        class="w-full"
        loading="eager"
      />
    </div>
  </div>
</section>

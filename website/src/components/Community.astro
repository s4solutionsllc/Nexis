---
const cards = [
  {
    title: 'Report Bugs',
    description: 'Found an issue? Let us know so we can fix it.',
    href: 'https://github.com/lsimpsonsfdc/Nexis/issues',
    linkText: 'Open an issue',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    title: 'Translate',
    description: '34 languages and growing. No coding required.',
    href: 'https://crowdin.com/project/nexis',
    linkText: 'Help translate',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>`,
  },
  {
    title: 'Contribute Code',
    description: 'Check the feature backlog and open a pull request.',
    href: 'https://github.com/lsimpsonsfdc/Nexis/blob/native/FEATURE_REQUESTS.md',
    linkText: 'View feature requests',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  },
];
---

<section id="community" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-white md:text-4xl">Get Involved</h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-nexis-muted">
      Nexis is open source and community-driven. Here's how you can help.
    </p>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      {cards.map(card => (
        <a
          href={card.href}
          class="group rounded-xl border border-nexis-border bg-nexis-dark-card p-6 transition-colors hover:border-nexis-orange/50"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-nexis-dark-surface text-nexis-orange" set:html={card.icon} />
          <h3 class="text-lg font-semibold text-white">{card.title}</h3>
          <p class="mt-2 text-sm text-nexis-muted">{card.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-nexis-orange group-hover:underline">
            {card.linkText} &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

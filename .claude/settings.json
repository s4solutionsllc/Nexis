{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(cmake --build *)",
      "Bash(cmake --build build -j$(sysctl -n hw.ncpu) 2>&1)",

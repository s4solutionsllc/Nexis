{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(cmake --build *)",
      "Bash(ctest *)",
      "Bash(rm -rf build && cmake *)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(gh *)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATH\" | grep -q 'CMakeLists.txt'; then echo '⚠️  CMakeLists.txt modified — clean rebuild recommended: /build-verify clean'; fi"
          }
        ]
      }
    ]
  }
}

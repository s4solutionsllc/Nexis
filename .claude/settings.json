{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(cmake --build *)",
      "Bash(ctest *)",
      "Bash(rm -rf build && cmake *)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(gh *)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "toolName": "edit",
          "filePaths": ["**/CMakeLists.txt"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️  CMakeLists.txt modified — clean rebuild recommended: /build-verify clean'"
          }
        ]
      }
    ]
  }
}
